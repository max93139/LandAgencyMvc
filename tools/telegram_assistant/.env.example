# Токен Telegram-бота, отриманий від @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example

# Ключ API Google Gemini (отримайте безкоштовно на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Список дозволених Telegram User ID через кому (рекомендовано для безпеки).
# Щоб дізнатися свій ID, напишіть боту @userinfobot або надішліть будь-яке повідомлення своєму боту —
# він виведе ваш ID у консоль та лог.
# Залиште порожнім, якщо хочете дозволити доступ будь-кому.
ALLOWED_TELEGRAM_USER_IDS=

# Модель Gemini (рекомендовано: gemini-2.0-flash або gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Шлях до кореневої папки проєкту LandAgencyMvc (за замовчуванням дві папки вгору від tools/telegram_assistant)
CODEBASE_PATH=../../

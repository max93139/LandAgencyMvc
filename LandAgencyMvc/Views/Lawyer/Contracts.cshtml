@model IEnumerable<LandAgencyMvc.Models.SaleDeal>
@{
    ViewData["Title"] = "Погодження проєктів договорів — Панель Юриста";
    ViewData["ActiveNav"] = "Contracts";
}

<div class="la-window">
    <partial name="_LawyerNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <h4>Погодження проєктів договорів купівлі-продажу перед передачею нотаріусу</h4>

        @if (!Model.Any())
        {
            <div class="la-card">
                <p class="text-muted">Проєктів договорів на погодження наразі немає.</p>
            </div>
        }
        else
        {
            @foreach (var d in Model)
            {
                <div class="la-card">
                    <div class="la-row-between">
                        <h5>Правова експертиза проєкту договору №@d.DraftContractNumber</h5>
                        <span class="la-badge @d.StatusBadgeClass">@d.StatusDisplayName</span>
                    </div>

                    <div class="la-subcard">
                        <div class="la-text-sm"><strong>Предмет договору:</strong> Земельна ділянка @d.LandPlot?.CadastralNumber (@d.LandPlot?.AreaHectares га, @d.LandPlot?.Title, @d.LandPlot?.Location)</div>
                        <div class="la-text-sm"><strong>Продавець:</strong> @d.LandPlot?.Seller?.FullName (РНОКПП @d.LandPlot?.Seller?.TaxId, Документ №@d.LandPlot?.OwnershipDocNumber)</div>
                        <div class="la-text-sm"><strong>Покупець:</strong> @d.Buyer?.FullName (РНОКПП @d.Buyer?.TaxId, Тел. @d.Buyer?.Phone)</div>
                        <div class="la-text-sm"><strong>Ціна договору:</strong> $@d.FinalPriceUsd.ToString("N0") • <strong>Комісія агентства (3%):</strong> $@d.AgencyCommissionUsd.ToString("N0") • <strong>Нотаріус:</strong> @d.NotaryOffice</div>
                        <div class="la-text-sm">
                            <strong class="text-success">
                                ✓ Юридичний висновок №@(d.LandPlot?.LegalConclusion?.ConclusionNumber ?? "ДЗК-Перевірено") дійсний, обтяжень на день угоди немає
                            </strong>
                        </div>
                        <div class="la-action-row">
                            <a asp-controller="Realtor" asp-action="PrintContract" asp-route-dealId="@d.Id" target="_blank" rel="noopener" class="la-btn la-btn-gray la-btn-sm">📄 Відкрити повний текст проєкту договору ↗</a>
                        </div>
                    </div>

                    @if (d.Status == LandAgencyMvc.Models.DealStatus.SignedAtNotary ||
                         d.Status == LandAgencyMvc.Models.DealStatus.CompletedAtNotary ||
                         d.Status == LandAgencyMvc.Models.DealStatus.Cancelled)
                    {
                        <div class="la-text-sm">
                            <strong>Примітка юриста:</strong> @(string.IsNullOrWhiteSpace(d.LawyerApprovalNotes) ? "Договір опрацьовано" : d.LawyerApprovalNotes)
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Lawyer" asp-action="ApproveDealContract" method="post">
                            <input type="hidden" name="dealId" value="@d.Id" />

                            <label class="la-label">Примітка юриста для нотаріального посвідчення</label>
                            <input name="lawyerNotes" value="@d.LawyerApprovalNotes" class="la-input" placeholder="Вкажіть висновок щодо відповідності проєкту договору вимогам Земельного кодексу України" />

                            <div class="la-action-row">
                                <button type="submit" name="decision" value="approve" class="la-btn la-btn-indigo">✓ Погодити договір до нотаріуса</button>
                                <button type="submit" name="decision" value="return" class="la-btn la-btn-red">Повернути на доопрацювання</button>
                            </div>
                        </form>
                    }
                </div>
            }
        }
    </div>
</div>

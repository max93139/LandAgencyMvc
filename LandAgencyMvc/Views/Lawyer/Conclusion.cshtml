@model LandAgencyMvc.Models.LawyerConclusionViewModel
@{
    var plot = Model.Plot;
    var dzk = Model.DzkExtract;
    var doc = plot.PrimaryDocument;
    ViewData["Title"] = $"Юридичний висновок по ділянці {plot.CadastralNumber} — Панель Юриста";
    ViewData["ActiveNav"] = "Conclusion";
}

<div class="la-window">
    <partial name="_LawyerNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />
        <div class="la-action-row">
            <a asp-controller="Lawyer" asp-action="Queue" class="la-btn la-btn-gray la-btn-sm">← Повернутися до черги ДЗК</a>
        </div>

        <div class="la-card">
            <div class="la-row-start">
                <h4>Правовий аудит та висновок по ділянці</h4>
                <partial name="_DzkLinks" model="plot" />
            </div>
            <p class="la-meta">
                Ділянка: <strong>@plot.CadastralNumber</strong> (@plot.AreaHectares га, @plot.Title) • Власник: <strong>@plot.Seller?.FullName</strong> (РНОКПП: @plot.Seller?.TaxId)
            </p>

            @if (dzk != null)
            {
                <div class="la-subcard">
                    <div class="la-row-between">
                        <strong>Електронний витяг ДЗК та ДРРП (№@dzk.ExtractNumber)</strong>
                        <span class="la-badge @(dzk.IsCadastralFormatValid ? "la-badge-green" : "la-badge-red")">
                            @(dzk.IsCadastralFormatValid ? "КОАТУУ підтверджено ✓" : "Помилка формату КОАТУУ ✗")
                        </span>
                    </div>

                    <div class="la-grid-3">
                        <div class="la-text-sm">Регіон КОАТУУ: <strong>@dzk.RegionName (@dzk.CadastralZoneCode)</strong></div>
                        <div class="la-text-sm">Нормативна оцінка (НГО): <strong>@dzk.NormativeMonetaryValuationUah.ToString("N0") грн</strong></div>
                        <div class="la-text-sm">Ціна за сотку: <strong>$@dzk.PricePerSotkaUsd.ToString("N0")</strong> <span class="text-muted">(середня: $@dzk.RegionalAvgPricePerSotkaUsd.ToString("N0"))</span></div>
                    </div>

                    @if (dzk.HasDrrpArrestsOrMortgages)
                    {
                        <div class="la-subcard-red">
                            <strong>⛔ Реєстр обтяжень ДРРП: Виявлено активний арешт, іпотеку або судову заборону відчуження (@dzk.RecommendedRiskLevel)</strong>
                        </div>
                    }
                    else if (dzk.HasDzkServitudesOrRestrictions)
                    {
                        <div class="la-subcard-amber">
                            <strong>⚠️ Кадастрові обмеження ДЗК: Зареєстровано земельний сервітут або охоронну зону інженерних мереж</strong>
                        </div>
                    }

                    @if (dzk.IsPriceAnomalyDetected)
                    {
                        <div class="la-subcard-amber">
                            <strong>⚠️ Ціновий комплаєнс: @dzk.PriceAnomalyReport</strong>
                        </div>
                    }
                    else
                    {
                        <div class="la-subcard-green">
                            ✓ Ринковий комплаєнс: @dzk.PriceAnomalyReport
                        </div>
                    }

                    <div class="la-text-sm">
                        Документ власності: <strong>@dzk.OwnershipRecordNumber</strong>
                        @if (doc != null)
                        {
                            <div class="la-text-xs">
                                @if (!string.IsNullOrWhiteSpace(doc.FileUrl))
                                {
                                    <span>Файл: <a href="@doc.FileUrl" target="_blank" rel="noopener"><strong>@doc.Title</strong></a></span>
                                }
                                else
                                {
                                    <span>Файл: <strong>@doc.Title</strong></span>
                                }
                                • SHA-256: <code class="la-code">@doc.ShortFileHash</code>
                                • ЕЦП/КЕП: <strong class="text-success">@(doc.IsSignedByKep ? doc.KepSignatureHash : "Без КЕП")</strong>
                            </div>
                        }
                    </div>
                </div>
            }

            <form asp-controller="Lawyer" asp-action="SubmitLegalConclusion" method="post">
                <input type="hidden" name="landPlotId" value="@plot.Id" />

                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Реєстраційний номер висновку</label>
                        <input name="conclusionNumber" value="@Model.DefaultConclusionNumber" class="la-input" required />
                    </div>
                    <div>
                        <label class="la-label">Дата проведення перевірки</label>
                        <input type="text" value="@DateTime.Now.ToString("dd.MM.yyyy")" class="la-input" readonly />
                    </div>
                    <div>
                        <label class="la-label">Рівень правового ризику</label>
                        <select name="riskLevel" class="la-input">
                            <option value="Низький (Чисто)" selected="@(Model.DefaultRiskLevel.StartsWith("Низький"))">Низький (Чисто)</option>
                            <option value="Середній (Потребує уточнення оцінки)" selected="@(Model.DefaultRiskLevel.StartsWith("Середній"))">Середній (Потребує уточнення оцінки)</option>
                            <option value="Високий (Виявлено обтяження / аномалію)" selected="@(Model.DefaultRiskLevel.StartsWith("Високий"))">Високий (Виявлено обтяження / аномалію)</option>
                        </select>
                    </div>
                </div>

                <label class="la-label">Результати перевірки за державними реєстрами та кадастром:</label>
                <div>
                    <label class="la-check-item">
                        <input type="checkbox" name="noArrests" value="true" checked="@Model.NoArrestsOrMortgages" />
                        ✓ Судових арештів, іпотек та заборон відчуження в ДРРП не виявлено
                    </label>
                    <label class="la-check-item">
                        <input type="checkbox" name="noServitudes" value="true" checked="@Model.NoServitudes" />
                        ✓ Земельних сервітутів та охоронних обмежень не зареєстровано
                    </label>
                    <label class="la-check-item">
                        <input type="checkbox" name="boundariesMatch" value="true" checked="@Model.BoundariesMatchDzk" />
                        ✓ Кадастрові межі повністю відповідають Публічній кадастровій карті ДЗК
                    </label>
                    <label class="la-check-item">
                        <input type="checkbox" name="sellerMatchesDrp" value="true" checked="@Model.SellerMatchesDrp" />
                        ✓ Правовстановлюючий документ та КЕП власника підтверджено в ДРРП
                    </label>
                    <label class="la-check-item">
                        <input type="checkbox" name="noSanctions" value="true" checked="@Model.NoSanctions" />
                        ✓ Власник відсутній у Єдиному реєстрі боржників та санкційних списках
                    </label>
                </div>

                <label class="la-label">Текст офіційного юридичного висновку / Акту ризиків</label>
                <textarea name="conclusionText" rows="3" class="la-input" required>@Model.DefaultConclusionText</textarea>

                @if (plot.Status == LandAgencyMvc.Models.PlotStatus.Sold)
                {
                    <div class="la-subcard-indigo">
                        <strong>🔒 Ділянку вже відчужено за нотаріальним договором. Юридичний висновок переведено в архівний режим тільки для читання.</strong>
                    </div>
                }
                else
                {
                    <div class="la-action-row">
                        <button type="submit" name="approve" value="true" class="la-btn la-btn-green">✓ Затвердити, опублікувати в каталог та запустити автопідбір</button>
                        <button type="submit" name="approve" value="false" class="la-btn la-btn-red">✕ Відхилити ділянку (Акт ризиків)</button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

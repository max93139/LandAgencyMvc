@model LandAgencyMvc.Models.LawyerQueueViewModel
@{
    ViewData["Title"] = "Статистика та Черга перевірки ДЗК — Панель Юриста";
    ViewData["ActiveNav"] = "Queue";
}

<div class="la-window">
    <partial name="_LawyerNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-grid-4">
            <div class="la-card">
                <div class="la-text-xs"><strong>УСЬОГО В РЕЄСТРІ</strong></div>
                <div class="la-stat-num">@Model.TotalPlotsCount</div>
            </div>
            <div class="la-card">
                <div class="la-text-xs"><strong>ПЕРЕВІРЕНО ДЗК</strong></div>
                <div class="la-stat-green">@Model.VerifiedPlotsCount</div>
            </div>
            <div class="la-card">
                <div class="la-text-xs"><strong>ОЧІКУЮТЬ АУДИТУ</strong></div>
                <div class="la-stat-amber">@Model.PendingPlotsCount</div>
            </div>
            <div class="la-card">
                <div class="la-text-xs"><strong>ВІДХИЛЕНО (АРЕШТ/АНОМАЛІЯ)</strong></div>
                <div class="la-stat-red">@Model.RejectedPlotsCount</div>
            </div>
        </div>

        <div class="la-card">
            <h4>Черга ділянок на перевірку в ДЗК та ДРРП</h4>
            @if (!Model.Plots.Any())
            {
                <p class="text-muted">У черзі наразі немає земельних ділянок.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>КАДАСТРОВИЙ №</th>
                            <th>ВЛАСНИК / ДОКУМЕНТ</th>
                            <th>СТАТУС</th>
                            <th>ДІЯ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Plots)
                        {
                            var firstDoc = p.PrimaryDocument;
                            <tr>
                                <td>
                                    <strong>@p.CadastralNumber</strong><br />
                                    <small><a href="@p.KadastrLiveUrl" target="_blank" rel="noopener">🗺️ kadastr.live ↗</a></small>
                                </td>
                                <td>
                                    <strong>@p.Seller?.FullName (@p.AreaHectares га, @p.Title)</strong><br />
                                    @if (p.Status == LandAgencyMvc.Models.PlotStatus.RejectedByLawyer)
                                    {
                                        <small class="text-danger">@(p.LegalConclusion?.ConclusionText ?? "Виявлено обтяження в ДРРП")</small>
                                    }
                                    else if (p.LegalConclusion != null)
                                    {
                                        <small class="text-muted">Висновок №@p.LegalConclusion.ConclusionNumber • Документ №@p.OwnershipDocNumber</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            @(firstDoc != null ? $"{firstDoc.DocType} №{firstDoc.DocumentNumber}" : $"Документ №{p.OwnershipDocNumber}")
                                            @(firstDoc?.IsSignedByKep == true ? "(КЕП ✓)" : "")
                                        </small>
                                    }
                                </td>
                                <td>
                                    <span class="la-badge @p.StatusBadgeClass">@p.StatusDisplayName</span>
                                </td>
                                <td>
                                    @if (p.Status == LandAgencyMvc.Models.PlotStatus.PendingLegalCheck)
                                    {
                                        <a class="la-btn la-btn-indigo la-btn-sm" asp-controller="Lawyer" asp-action="Conclusion" asp-route-id="@p.Id">Скласти висновок →</a>
                                    }
                                    else
                                    {
                                        <a class="la-btn la-btn-gray la-btn-sm" asp-controller="Lawyer" asp-action="Conclusion" asp-route-id="@p.Id">Переглянути акт</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@model LandAgencyMvc.Models.PlotsFilterViewModel
@{
    ViewData["Title"] = "Запит 1 — Відбір та сортування земельних ділянок";
    ViewData["ActiveNav"] = "FilterPlots";
}

<div class="la-window">
    <partial name="_QueriesNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-card">
            <div class="la-row-between">
                <div>
                    <h2>Запит 1: Відбір земельних ділянок за умовою та сортування</h2>
                    <p class="la-meta">
                        Демонстрація методів розширення LINQ to Entities: <code>Where()</code>, <code>OrderBy()</code>, <code>OrderByDescending()</code>, <code>Select()</code> проекція.
                    </p>
                </div>
                <a class="la-btn la-btn-gray la-btn-sm" asp-controller="Queries" asp-action="Index">← До переліку звітів</a>
            </div>
        </div>

        <div class="la-card">
            <h3>Параметри фільтрації та критерії відбору</h3>
            <form method="get" asp-controller="Queries" asp-action="FilterPlots">
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Область / Район / Локація</label>
                        <input class="la-input" name="Region" value="@Model.Filter.Region" placeholder="напр. Київська, Львівська, Одеська" />
                    </div>

                    <div>
                        <label class="la-label">Цільове призначення (КВЦПЗ)</label>
                        <select class="la-input" name="Purpose">
                            <option value="">-- Усі призначення --</option>
                            <option value="02.01" selected="@(Model.Filter.Purpose == "02.01")">02.01 Для житлового будинку</option>
                            <option value="01.01" selected="@(Model.Filter.Purpose == "01.01")">01.01 Товарне с/г виробництво</option>
                            <option value="01.03" selected="@(Model.Filter.Purpose == "01.03")">01.03 Особисте селянське господарство</option>
                            <option value="03.07" selected="@(Model.Filter.Purpose == "03.07")">03.07 Курортні готелі та рекреація</option>
                            <option value="11.01" selected="@(Model.Filter.Purpose == "11.01")">11.01 Промислові об'єкти</option>
                            <option value="11.02" selected="@(Model.Filter.Purpose == "11.02")">11.02 Розміщення складів</option>
                        </select>
                    </div>

                    <div>
                        <label class="la-label">Статус лістингу</label>
                        <select class="la-input" name="Status">
                            <option value="">-- Усі статуси --</option>
                            <option value="VerifiedInCatalog" selected="@(Model.Filter.Status == LandAgencyMvc.Models.PlotStatus.VerifiedInCatalog)">Опубліковано в каталозі</option>
                            <option value="PendingLegalCheck" selected="@(Model.Filter.Status == LandAgencyMvc.Models.PlotStatus.PendingLegalCheck)">На перевірці у юриста</option>
                            <option value="Sold" selected="@(Model.Filter.Status == LandAgencyMvc.Models.PlotStatus.Sold)">Продано (Угода завершена)</option>
                        </select>
                    </div>

                    <div>
                        <label class="la-label">Ціна від ($)</label>
                        <input type="number" step="1000" class="la-input" name="MinPrice" value="@Model.Filter.MinPrice" placeholder="0" />
                    </div>

                    <div>
                        <label class="la-label">Ціна до ($)</label>
                        <input type="number" step="1000" class="la-input" name="MaxPrice" value="@Model.Filter.MaxPrice" placeholder="100000" />
                    </div>

                    <div>
                        <label class="la-label">Площа від (га)</label>
                        <input type="number" step="0.05" class="la-input" name="MinArea" value="@Model.Filter.MinArea" placeholder="0.10" />
                    </div>

                    <div>
                        <label class="la-label">Площа до (га)</label>
                        <input type="number" step="0.05" class="la-input" name="MaxArea" value="@Model.Filter.MaxArea" placeholder="3.00" />
                    </div>

                    <div>
                        <label class="la-label">Учасник (ПІБ, телефон, email)</label>
                        <input class="la-input" name="Participant" value="@Model.Filter.Participant" placeholder="Шевченко, Бондар..." />
                    </div>

                    <div>
                        <label class="la-label">Сортування</label>
                        <select class="la-input" name="Sort">
                            <option value="Date" selected="@(Model.Filter.Sort == LandAgencyMvc.Services.PlotSort.Date)">За датою лістингу</option>
                            <option value="Price" selected="@(Model.Filter.Sort == LandAgencyMvc.Services.PlotSort.Price)">За загальною ціною ($)</option>
                            <option value="Area" selected="@(Model.Filter.Sort == LandAgencyMvc.Services.PlotSort.Area)">За площею (га)</option>
                            <option value="PricePerSotka" selected="@(Model.Filter.Sort == LandAgencyMvc.Services.PlotSort.PricePerSotka)">За ціною за сотку ($/сотка)</option>
                            <option value="Title" selected="@(Model.Filter.Sort == LandAgencyMvc.Services.PlotSort.Title)">За назвою ділянки</option>
                            <option value="Location" selected="@(Model.Filter.Sort == LandAgencyMvc.Services.PlotSort.Location)">За локацією / областю</option>
                        </select>
                    </div>
                </div>

                <div class="la-row-between">
                    <div>
                        <label class="la-label">Напрямок сортування:</label>
                        <select class="la-input" name="Descending">
                            <option value="true" selected="@Model.Filter.Descending">За спаданням (від більшого до меншого)</option>
                            <option value="false" selected="@(!Model.Filter.Descending)">За зростанням (від меншого до більшого)</option>
                        </select>
                    </div>
                    <div>
                        <a class="la-btn la-btn-gray la-btn-sm" asp-controller="Queries" asp-action="FilterPlots">Скинути фільтр</a>
                        <button type="submit" class="la-btn la-btn-indigo la-btn-sm">Застосувати LINQ-фільтр</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="la-card">
            <div class="la-row-between">
                <h3>Результати вибірки (@Model.Result.Rows.Count об'єктів знайдено)</h3>
                <div>
                    <span class="la-badge la-badge-indigo">Площа: @Model.Result.Rows.Sum(r => r.AreaHectares).ToString("F2") га</span>
                    <span class="la-badge la-badge-green">Сума: @Model.Result.Rows.Sum(r => r.PriceUsd).ToString("N0") $</span>
                </div>
            </div>

            @if (Model.Result.Rows.Count == 0)
            {
                <p class="la-meta">За вказаними критеріями ділянок не знайдено. Спробуйте змінити фільтри.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>Кадастровий номер</th>
                            <th>Назва та локація</th>
                            <th>Площа</th>
                            <th>Призначення</th>
                            <th>Ціна ($)</th>
                            <th>Ціна / сотку</th>
                            <th>Статус</th>
                            <th>Продавець</th>
                            <th>Рієлтор</th>
                            <th>Ризик ДЗК</th>
                            <th>Дата</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Result.Rows)
                        {
                            <tr>
                                <td><code>@p.CadastralNumber</code></td>
                                <td>
                                    <strong>@p.Title</strong><br />
                                    <small class="la-meta">@p.Location</small>
                                </td>
                                <td>@p.AreaHectares га (@p.AreaSotky сот.)</td>
                                <td><small>@p.Purpose</small></td>
                                <td><strong>@p.PriceUsd.ToString("N0") $</strong></td>
                                <td>@p.PricePerSotkaUsd.ToString("N0") $/сот.</td>
                                <td>
                                    @if (p.Status == LandAgencyMvc.Models.PlotStatus.VerifiedInCatalog)
                                    {
                                        <span class="la-badge la-badge-green">Опубліковано</span>
                                    }
                                    else if (p.Status == LandAgencyMvc.Models.PlotStatus.Sold)
                                    {
                                        <span class="la-badge la-badge-indigo">Продано</span>
                                    }
                                    else
                                    {
                                        <span class="la-badge la-badge-amber">На перевірці</span>
                                    }
                                </td>
                                <td>
                                    @p.SellerName<br />
                                    <small class="la-meta">@p.SellerPhone</small>
                                </td>
                                <td>@p.RealtorName</td>
                                <td>
                                    @if (p.RiskLevel.Contains("Чисто") || p.RiskLevel.Contains("Низький"))
                                    {
                                        <span class="la-badge la-badge-green">@p.RiskLevel</span>
                                    }
                                    else
                                    {
                                        <span class="la-badge la-badge-red">@p.RiskLevel</span>
                                    }
                                </td>
                                <td>@p.CreatedAt.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Result.SqlQuery))
        {
            <div class="la-card">
                <h4>Згенерований SQL-запит (LINQ to Entities via EF Core ToQueryString)</h4>
                <div class="la-code-block">
                    <pre><code>@Model.Result.SqlQuery</code></pre>
                </div>
            </div>
        }
    </div>
</div>

@model LandAgencyMvc.Models.PeriodTurnoverViewModel
@{
    ViewData["Title"] = "Запити 2–3 — Підсумки торгів та оборот за період";
    ViewData["ActiveNav"] = "PeriodTurnover";
}

<div class="la-window">
    <partial name="_QueriesNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-card">
            <div class="la-row-between">
                <div>
                    <h2>Запити 2 та 3: Узагальнення та підсумки за вказаний користувачем період</h2>
                    <p class="la-meta">
                        Період: <strong>@Model.Period.Label</strong> (з @Model.Period.From.ToString("dd.MM.yyyy HH:mm") по @Model.Period.To.ToString("dd.MM.yyyy HH:mm"))
                    </p>
                </div>
                <a class="la-btn la-btn-gray la-btn-sm" asp-controller="Queries" asp-action="Index">← До переліку звітів</a>
            </div>
        </div>

        <div class="la-card">
            <h3>Вибір часового проміжку та впорядкування</h3>
            <form method="get" asp-controller="Queries" asp-action="PeriodTurnover">
                <div class="la-grid-4">
                    <div>
                        <label class="la-label">Тип періоду</label>
                        <select class="la-input" name="kind">
                            <option value="Day" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.Day)">День (конкретна дата)</option>
                            <option value="Month" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.Month)">Місяць</option>
                            <option value="HalfYear" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.HalfYear)">Півріччя (I або II)</option>
                            <option value="Custom" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.Custom)">Довільний діапазон «з … по …»</option>
                        </select>
                    </div>

                    <div>
                        <label class="la-label">Опорна дата (день / місяць / півріччя)</label>
                        <input type="date" class="la-input" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="la-label">Довільний період: Дата З</label>
                        <input type="date" class="la-input" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="la-label">Довільний період: Дата По</label>
                        <input type="date" class="la-input" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="la-row-between">
                    <div>
                        <label>
                            Сортування підсумків:
                            <select name="sort" class="la-input">
                                <option value="Turnover" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Turnover)">За фінансовим оборотом ($)</option>
                                <option value="Deals" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Deals)">За кількістю угод</option>
                                <option value="Area" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Area)">За загальною площею (га)</option>
                                <option value="Name" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Name)">За назвою категорії</option>
                            </select>
                        </label>
                        <label>
                            <input type="checkbox" name="desc" value="true" checked="@Model.Descending" />
                            За спаданням
                        </label>
                    </div>
                    <div>
                        <button type="submit" class="la-btn la-btn-green la-btn-sm">Розрахувати підсумки за період</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="la-grid-4">
            <div class="la-card">
                <span class="la-stat-num">@Model.TotalTurnoverUsd.ToString("N0") $</span>
                <span class="la-meta">Оборот реалізованих земель</span>
            </div>
            <div class="la-card">
                <span class="la-stat-num">@Model.TotalCommissionUsd.ToString("N2") $</span>
                <span class="la-meta">Винагорода агентства (3%)</span>
            </div>
            <div class="la-card">
                <span class="la-stat-num">@Model.TotalDeals</span>
                <span class="la-meta">Укладених нотаріальних угод</span>
            </div>
            <div class="la-card">
                <span class="la-stat-num">@Model.TotalAreaHa.ToString("F2") га</span>
                <span class="la-meta">Загальна відчужена площа</span>
            </div>
        </div>

        <div class="la-card">
            <h3>Запит 2: Реалізація земель у розрізі цільового призначення (КВЦПЗ)</h3>
            <p class="la-meta">
                Обчислення через LINQ Query Syntax: <code>from d in db.SaleDeals group d by d.LandPlot.Purpose into g select new { ... }</code>. Розрахунок <code>Count()</code>, <code>Sum()</code>, <code>Average()</code>, <code>Min()</code>, <code>Max()</code>.
            </p>

            @if (Model.ByPurpose.Rows.Count == 0)
            {
                <p class="la-meta">За обраний період угод не зафіксовано. Оберіть інший місяць або діапазон (наприклад, 2026 рік).</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>Цільове призначення земель (КВЦПЗ)</th>
                            <th>К-сть угод</th>
                            <th>Площа (га)</th>
                            <th>Оборот ($)</th>
                            <th>Комісія 3% ($)</th>
                            <th>Середня ціна ($)</th>
                            <th>Мін. ціна ($)</th>
                            <th>Макс. ціна ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ByPurpose.Rows)
                        {
                            <tr>
                                <td><strong>@row.Purpose</strong></td>
                                <td>@row.DealsCount</td>
                                <td>@row.TotalAreaHectares.ToString("F2") га</td>
                                <td><strong>@row.TotalTurnoverUsd.ToString("N0") $</strong></td>
                                <td>@row.TotalCommissionUsd.ToString("N2") $</td>
                                <td>@row.AveragePriceUsd.ToString("N0") $</td>
                                <td>@row.MinPriceUsd.ToString("N0") $</td>
                                <td>@row.MaxPriceUsd.ToString("N0") $</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>РАЗОМ ЗА ПЕРІОД:</th>
                            <th>@Model.TotalDeals</th>
                            <th>@Model.TotalAreaHa.ToString("F2") га</th>
                            <th>@Model.TotalTurnoverUsd.ToString("N0") $</th>
                            <th>@Model.TotalCommissionUsd.ToString("N2") $</th>
                            <th>@Model.AvgDealPriceUsd.ToString("N0") $</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>

        <div class="la-card">
            <h3>Запит 3: Оборот, активність та рейтинг рієлторів і юристів за той самий період</h3>
            <p class="la-meta">
                Реляційне з'єднання <code>SaleDeals</code> → <code>Realtor</code> та <code>Lawyer</code>. Групування за фахівцем для аналізу ефективності продажів та юридичного супроводу.
            </p>

            @if (Model.ByAgent.Rows.Count == 0)
            {
                <p class="la-meta">За обраний період активності фахівців не зафіксовано.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>Фахівець агентства</th>
                            <th>Посада / Роль</th>
                            <th>Контактний телефон</th>
                            <th>Укладено угод</th>
                            <th>Площа (га)</th>
                            <th>Загальний оборот ($)</th>
                            <th>Згенерована комісія ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model.ByAgent.Rows)
                        {
                            <tr>
                                <td><strong>@agent.AgentName</strong></td>
                                <td><span class="la-badge la-badge-indigo">@agent.RoleTitle</span></td>
                                <td>@agent.Phone</td>
                                <td>@agent.DealsCount</td>
                                <td>@agent.TotalAreaHectares.ToString("F2") га</td>
                                <td><strong>@agent.TotalTurnoverUsd.ToString("N0") $</strong></td>
                                <td>@agent.TotalCommissionUsd.ToString("N2") $</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ByPurpose.SqlQuery))
        {
            <div class="la-card">
                <h4>Згенерований SQL-запит (Запит 2 LINQ to Entities)</h4>
                <div class="la-code-block">
                    <pre><code>@Model.ByPurpose.SqlQuery</code></pre>
                </div>
            </div>
        }
    </div>
</div>

@{
    ViewData["Title"] = "Вхід у систему — LandAgency UA";
    ViewData["ActiveNav"] = "Login";
}

<div class="la-window">
    <partial name="_AuthNavbar" />
    <div class="la-body la-auth-page">
        <div class="la-card la-auth-card">
            <h4 class="mb-1">Вхід в особистий кабінет</h4>
            <p class="la-meta mb-3">Введіть вашу електронну пошту та пароль для доступу до системи</p>

            <partial name="_AlertMessages" />

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <label class="la-label">Електронна пошта (Логін)</label>
                <input name="email" type="email" class="la-input" placeholder="name@example.com" required />

                <label class="la-label">Пароль</label>
                <input name="password" type="password" class="la-input" placeholder="Введіть пароль" required />

                <button type="submit" class="la-btn la-btn-green la-btn-full mt-1">Увійти</button>
            </form>

            <div class="la-text-sm text-center mt-3">
                Ще не маєте акаунту? <a asp-controller="Account" asp-action="Register" class="fw-bold text-success text-decoration-none">Зареєструватися</a>
            </div>
        </div>
    </div>
</div>

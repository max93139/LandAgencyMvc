@{
    ViewData["Title"] = "Вхід у систему — LandAgency UA";
}

<div class="la-window">
    <div class="la-topbar la-topbar-auth">
        <strong style="font-size:18px;">LandAgency UA</strong>
        <div class="la-nav-links">
            <a class="active" asp-controller="Account" asp-action="Login">Увійти</a>
            <a asp-controller="Account" asp-action="Register">Реєстрація</a>
        </div>
    </div>
    <div class="la-body" style="display:flex; justify-content:center; align-items:center;">
        <div class="la-card" style="width:440px;">
            <h4 style="margin-bottom:6px;">Вхід в особистий кабінет</h4>
            <p class="text-muted" style="font-size:14px; margin-bottom:18px;">Введіть вашу електронну пошту та пароль для доступу до системи</p>

            @if (TempData["LoginError"] != null)
            {
                <div class="la-alert la-alert-error">
                    @TempData["LoginError"]
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <label class="la-label">Електронна пошта (Логін)</label>
                <input name="email" type="email" class="la-input" placeholder="name@example.com" required />

                <label class="la-label">Пароль</label>
                <input name="password" type="password" class="la-input" placeholder="Введіть пароль" required />

                <button type="submit" class="la-btn la-btn-green" style="width:100%; margin-top:4px;">Увійти</button>
            </form>

            <div style="margin-top:16px; text-align:center; font-size:13px;">
                Ще не маєте акаунту? <a asp-controller="Account" asp-action="Register" style="color:#16a34a; font-weight:700; text-decoration:none;">Зареєструватися</a>
            </div>

            <div style="margin-top:20px; padding-top:16px; border-top:1px solid #e2e8f0;">
                <span class="text-muted" style="font-size:11px; font-weight:700; display:block; margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">Демо-доступ для тестування ролей:</span>
                <div style="display:flex; flex-direction:column; gap:6px;">
                    <button type="button" onclick="fillLogin('realtor@landagency.ua', 'realtor123')" class="la-btn" style="background:#fef3c7; color:#92400e; padding:7px 12px; font-size:12px; text-align:left; border-radius:6px;">🏢 Рієлтор: realtor@landagency.ua / realtor123</button>
                    <button type="button" onclick="fillLogin('lawyer@landagency.ua', 'lawyer123')" class="la-btn" style="background:#e0e7ff; color:#3730a3; padding:7px 12px; font-size:12px; text-align:left; border-radius:6px;">⚖️ Юрист: lawyer@landagency.ua / lawyer123</button>
                </div>
            </div>
            <script>
                function fillLogin(email, pass) {
                    document.querySelector('input[name="email"]').value = email;
                    document.querySelector('input[name="password"]').value = pass;
                }
            </script>
        </div>
    </div>
</div>

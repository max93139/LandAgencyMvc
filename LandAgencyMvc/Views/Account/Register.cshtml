@{
    ViewData["Title"] = "Реєстрація клієнта — LandAgency UA";
    ViewData["ActiveNav"] = "Register";
}

<div class="la-window">
    <partial name="_AuthNavbar" />
    <div class="la-body" style="display:flex; justify-content:center; align-items:center;">
        <div class="la-card" style="width:540px;">
            <h4 style="margin-bottom:6px;">Реєстрація нового клієнта</h4>
            <p class="text-muted" style="font-size:14px; margin-bottom:18px;">Створення єдиного облікового запису для купівлі та продажу земельних ділянок</p>

            <partial name="_AlertMessages" />

            <form asp-controller="Account" asp-action="Register" method="post">
                <label class="la-label">Прізвище, ім'я та по батькові (ПІБ)</label>
                <input name="fullName" class="la-input" placeholder="Прізвище Ім'я По батькові" required />

                <label class="la-label">Номер телефону</label>
                <input name="phone" class="la-input" placeholder="+380 XX XXX XX XX" required />

                <label class="la-label">Електронна пошта (Логін)</label>
                <input name="email" type="email" class="la-input" placeholder="name@ukr.net" required />

                <label class="la-label">Пароль</label>
                <input name="password" type="password" class="la-input" placeholder="Мінімум 6 символів" required />

                <button type="submit" class="la-btn la-btn-green" style="width:100%;">Зареєструватися</button>
            </form>

            <div style="margin-top:16px; text-align:center; font-size:13px;">
                Вже є акаунт? <a asp-controller="Account" asp-action="Login" style="color:#16a34a; font-weight:700; text-decoration:none;">Увійти в систему</a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Службовий вхід — LandAgency UA";
    ViewData["ActiveNav"] = "StaffLogin";
}

<div class="la-window">
    <partial name="_AuthNavbar" />
    <div class="la-body la-auth-page">
        <div class="la-card la-auth-card">
            <h4 class="mb-1">Службовий вхід</h4>
            <p class="la-meta mb-3">Доступ для рієлторів і юристів агентства. Покупці та продавці входять через сторінку входу для клієнтів.</p>

            <partial name="_AlertMessages" />

            <form asp-controller="Account" asp-action="StaffLogin" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <label class="la-label">Службова електронна пошта</label>
                <input name="email" type="email" class="la-input" placeholder="name@landagency.ua" required />

                <label class="la-label">Пароль</label>
                <input name="password" type="password" class="la-input" placeholder="Введіть пароль" required />

                <button type="submit" class="la-btn la-btn-dark la-btn-full mt-1">Увійти як співробітник</button>
            </form>

            <div class="la-text-sm text-center mt-3">
                Ви клієнт агентства? <a asp-controller="Account" asp-action="Login" class="fw-bold text-success text-decoration-none">Вхід для клієнтів</a>
            </div>
        </div>
    </div>
</div>

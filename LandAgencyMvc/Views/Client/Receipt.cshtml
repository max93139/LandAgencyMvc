@model LandAgencyMvc.Models.SaleDeal
@{
    ViewData["Title"] = $"Квитанція про оплату — Угода {Model.DraftContractNumber}";
}

<div class="la-window">
    <div class="la-body">
        <div class="la-card p-4">
            <div class="la-row-start border-bottom pb-3 mb-3">
                <div>
                    <h4 class="mb-0">БАНКІВСЬКА КВИТАНЦІЯ ЗА ДОГОВОРОМ КУПІВЛІ-ПРОДАЖУ</h4>
                    <p class="la-meta mt-1 mb-0">Договір № @Model.DraftContractNumber від @Model.NotaryDate.ToString("dd.MM.yyyy") • LandAgency UA</p>
                </div>
                <span class="la-badge @(Model.IsFullyPaid ? "la-badge-green" : "la-badge-amber")">
                    @(Model.IsFullyPaid ? "✓ ОПЛАЧЕНО" : "РАХУНОК ДО СПЛАТИ")
                </span>
            </div>

            <div class="la-grid-2 mb-3">
                <div>
                    <strong>Платник (Покупець):</strong><br />
                    ПІБ: @Model.Buyer?.FullName<br />
                    РНОКПП (ІПН): @Model.Buyer?.TaxId<br />
                    Телефон: @Model.Buyer?.Phone
                </div>
                <div>
                    <strong>Одержувач (Продавець ділянки):</strong><br />
                    ПІБ: @Model.LandPlot?.Seller?.FullName<br />
                    РНОКПП (ІПН): @Model.LandPlot?.Seller?.TaxId<br />
                    IBAN: @Model.LandPlot?.EffectiveSellerIban
                </div>
            </div>

            <div class="la-subcard mb-3">
                <strong>Призначення платежу:</strong> Оплата за земельну ділянку з кадастровим номером <strong>@Model.LandPlot?.CadastralNumber</strong> (площа @Model.LandPlot?.AreaHectares га, @Model.LandPlot?.Location) згідно з договором купівлі-продажу №@Model.DraftContractNumber.
            </div>

            <table class="la-table mb-3">
                <thead>
                    <tr>
                        <th>№ Рахунку / Квитанції</th>
                        <th>Призначення транзакції</th>
                        <th>Рахунок одержувача (IBAN)</th>
                        <th>Сума (USD)</th>
                        <th>Статус банківської виписки</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>
                                <strong>@(string.IsNullOrEmpty(p.InvoiceNumber) ? p.ReceiptNumber : p.InvoiceNumber)</strong>
                                @if (!string.IsNullOrEmpty(p.PaymentReference))
                                {
                                    <div class="la-text-xs">Ref: <code>@p.PaymentReference</code></div>
                                }
                            </td>
                            <td>@p.PaymentType</td>
                            <td><code>@p.RecipientIban</code></td>
                            <td><strong>$@p.AmountUsd.ToString("N2")</strong></td>
                            <td>
                                <span class="la-badge @p.StatusBadgeClass">@p.StatusDisplayName</span>
                            </td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td colspan="3">РАЗОМ ЗА УГОДОЮ:</td>
                        <td>$@Model.TotalAmountUsd.ToString("N2")</td>
                        <td>@(Model.IsFullyPaid ? "Виконано в повному обсязі" : "Очікує повного розрахунку")</td>
                    </tr>
                </tbody>
            </table>

            <div class="la-row-between mt-4">
                <button onclick="window.print()" class="la-btn la-btn-dark">Друкувати / Зберегти у PDF</button>
                <a asp-controller="Client" asp-action="Cabinet" class="la-btn la-btn-gray">← Повернутися до кабінету</a>
            </div>
        </div>
    </div>
</div>

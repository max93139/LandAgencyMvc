@model LandAgencyMvc.Models.LandPlot
@{
    ViewData["Title"] = $"{Model.Title} — LandAgency UA";
    ViewData["ActiveNav"] = "Details";
    var staffNavbar = User.IsInRole(LandAgencyMvc.Models.AppRoles.Realtor) ? "_RealtorNavbar"
        : User.IsInRole(LandAgencyMvc.Models.AppRoles.Lawyer) ? "_LawyerNavbar"
        : null;
    var conclusion = Model.LegalConclusion;
}

<div class="la-window">
    <partial name="@(staffNavbar ?? "_ClientNavbar")" />

    <div class="la-body">
        <partial name="_AlertMessages" />
        <div class="la-grid-2">
            <div class="la-card">
                <div class="la-row-between">
                    <span class="la-badge @Model.StatusBadgeClass">@Model.StatusDisplayName</span>
                    <strong class="la-price-xl">$@Model.PriceUsd.ToString("N0")</strong>
                </div>

                <h4 class="mt-2 mb-1">@Model.Title (@Model.AreaHectares га)</h4>
                <div class="la-row-between mb-3">
                    <span class="la-meta mb-0">Кадастровий №: <strong>@Model.CadastralNumber</strong></span>
                    <partial name="_DzkLinks" model="Model" />
                </div>

                <table class="la-table mb-3">
                    <tbody>
                        <tr>
                            <td class="text-muted">Власник:</td>
                            <td><strong>@Model.Seller?.FullName</strong> (@Model.Seller?.Phone)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Адреса розташування:</td>
                            <td>@Model.Location</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Площа та ціна за сотку:</td>
                            <td><strong>@Model.AreaHectares га</strong> (@Model.AreaSotky соток • $@Model.PricePerSotkaUsd.ToString("N0") / сотка)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Цільове призначення:</td>
                            <td><strong>@Model.Purpose</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Юридичний висновок:</td>
                            <td>
                                @if (Model.LegalConclusion != null)
                                {
                                    <span class="fw-bold @(Model.LegalConclusion.IsApproved ? "text-success" : "text-danger")">
                                        №@Model.LegalConclusion.ConclusionNumber (@Model.LegalConclusion.RiskLevel)
                                    </span>
                                }
                                else
                                {
                                    <span>Очікує правової експертизи ДЗК</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Рієлтор об'єкта:</td>
                            <td>
                                @if (Model.AssignedRealtor != null)
                                {
                                    <strong>@Model.AssignedRealtor.FullName (@Model.AssignedRealtor.Phone, ліц. @Model.AssignedRealtor.LicenseNumber)</strong>
                                }
                                else
                                {
                                    <span>Черговий рієлтор агентства</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="la-subcard">
                    <strong class="la-text-sm">Опис ділянки:</strong>
                    <p class="la-text-sm mt-1 mb-0">@Model.Description</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SaleConditions))
                {
                    <div class="la-subcard">
                        <strong class="la-text-sm">Умови продажу:</strong>
                        <p class="la-text-sm mt-1 mb-0">@Model.SaleConditions</p>
                    </div>
                }

                @if (Model.HasCoordinates)
                {
                    <div class="la-subcard la-row-between">
                        <span class="la-text-sm">
                            <strong>Координати:</strong> @Model.Latitude!.Value.ToString("0.0000"), @Model.Longitude!.Value.ToString("0.0000")
                        </span>
                        <a href="@Model.MapUrl" target="_blank" rel="noopener" class="la-btn la-btn-white la-btn-xs">Показати на карті ↗</a>
                    </div>
                }

                @if (Model.Media.Any())
                {
                    <div class="la-subcard">
                        <strong class="la-text-sm d-block mb-2">Фото та відео ділянки:</strong>
                        <div class="la-gallery">
                            @foreach (var item in Model.Media.OrderBy(m => m.Id))
                            {
                                <figure class="la-gallery-item">
                                    <partial name="_PlotMediaItem" model="item" />
                                </figure>
                            }
                        </div>
                    </div>
                }

                @if (conclusion != null)
                {
                    <div class="la-subcard mb-3">
                        <strong class="la-text-sm d-block mb-2">
                            Юридичний висновок №@conclusion.ConclusionNumber
                            <span class="@(conclusion.IsApproved ? "text-success" : "text-danger")">— @(conclusion.IsApproved ? "ділянку схвалено" : "виявлено ризики")</span>
                        </strong>
                        <div class="la-text-sm text-muted mb-2">
                            @conclusion.CreatedAt.ToString("dd.MM.yyyy") • юрист @(conclusion.Lawyer?.FullName ?? "—") • рівень ризику: @conclusion.RiskLevel
                            @if (!string.IsNullOrWhiteSpace(conclusion.DzkExtractNumber))
                            {
                                <span>• витяг ДЗК №@conclusion.DzkExtractNumber</span>
                            }
                        </div>
                        <ul class="la-text-sm mb-2 ps-3">
                            <li>@(conclusion.NoArrestsOrMortgages ? "✓" : "✗") арештів та іпотеки немає</li>
                            <li>@(conclusion.NoServitudes ? "✓" : "✗") сервітутів немає</li>
                            <li>@(conclusion.BoundariesMatchDzk ? "✓" : "✗") межі збігаються з ДЗК</li>
                            <li>@(conclusion.SellerMatchesDrp ? "✓" : "✗") продавець збігається з власником у ДРРП</li>
                            <li>@(conclusion.NoSanctions ? "✓" : "✗") санкцій щодо власника немає</li>
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(conclusion.ConclusionText))
                        {
                            <div class="la-text-sm">@conclusion.ConclusionText</div>
                        }
                    </div>
                }

                @if (Model.Documents.Any())
                {
                    <div>
                        <strong class="la-text-sm d-block mb-2">Правовстановлюючі документи ділянки:</strong>
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="la-subcard-green la-row-between py-2 px-3 mb-2">
                                <div class="la-text-xs">
                                    <strong>@doc.Title</strong> (@doc.DocType №@doc.DocumentNumber від @doc.IssueDate.ToString("dd.MM.yyyy"))<br />
                                    @if (doc.IsVerified)
                                    {
                                        <span class="la-badge la-badge-green mt-1">✓ Перевірено юристом у ДРРП</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(doc.FileUrl))
                                {
                                    <a href="@doc.FileUrl" target="_blank" class="la-btn la-btn-white la-btn-xs">Переглянути витяг ↗</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="la-card">
                <h5>@(staffNavbar != null ? "Дії співробітника" : "Записатися на виїзний огляд")</h5>
                @if (User.IsInRole(AppRoles.Realtor))
                {
                    <div class="la-subcard la-text-sm mb-2">Ви переглядаєте картку ділянки так, як її бачать клієнти.</div>
                    @if (Model.IsEditable)
                    {
                        <a asp-controller="Realtor" asp-action="EditPlot" asp-route-id="@Model.Id" class="la-btn la-btn-dark la-btn-sm">Редагувати ділянку</a>
                    }
                    <a asp-controller="Realtor" asp-action="Plots" class="la-btn la-btn-outline la-btn-sm">До реєстру ділянок</a>
                }
                else if (User.IsInRole(AppRoles.Lawyer))
                {
                    <div class="la-subcard la-text-sm mb-2">Ви переглядаєте картку ділянки так, як її бачать клієнти.</div>
                    <a asp-controller="Lawyer" asp-action="Conclusion" asp-route-id="@Model.Id" class="la-btn la-btn-indigo la-btn-sm">
                        @(Model.Status == LandAgencyMvc.Models.PlotStatus.PendingLegalCheck ? "Скласти висновок" : "Відкрити юридичний висновок")
                    </a>
                }
                else if (Model.IsOwnedBy(User))
                {
                    <div class="la-subcard la-text-sm">
                        Це ваше власне оголошення на продаж. Керувати ціною та документами можна у розділі <a asp-controller="Client" asp-action="Cabinet" class="fw-bold">Мій кабінет</a>.
                    </div>
                }
                else if (!User.IsInRole(AppRoles.Buyer))
                {
                    <div class="la-subcard la-text-sm">
                        Записатися на виїзний огляд можуть лише покупці.
                    </div>
                }
                else if (Model.Status != LandAgencyMvc.Models.PlotStatus.VerifiedInCatalog)
                {
                    <div class="la-subcard la-text-sm">
                        Запис на виїзний огляд наразі недоступний: ділянка перебуває у статусі <strong>«@Model.StatusDisplayName»</strong>.
                    </div>
                }
                else
                {
                    <p class="la-meta mb-3">Оберіть зручний час виїзду на ділянку для огляду межових знаків, комунікацій та оригіналів документів з рієлтором</p>

                    <form asp-controller="Client" asp-action="CreateViewing" method="post">
                        <input type="hidden" name="landPlotId" value="@Model.Id" />

                        <label class="la-label">Бажана дата огляду</label>
                        <input type="date" name="preferredDate" class="la-input" required />

                        <label class="la-label">Бажаний час</label>
                        <input name="timeSlot" type="time" class="la-input" required />

                        <label class="la-label">Коментар для рієлтора</label>
                        <textarea name="comment" rows="3" class="la-input" placeholder="Вкажіть побажання щодо огляду межових знаків, під'їзної дороги чи комунікацій"></textarea>

                        <button type="submit" class="la-btn la-btn-blue la-btn-full">Подати заявку на огляд</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@model LandAgencyMvc.Models.LandPlot
@{
    ViewData["Title"] = $"{Model.Title} — LandAgency UA";
    ViewData["ActiveNav"] = "Details";
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />
        <div class="la-grid-2">
            <div class="la-card">
                <div class="la-row-between">
                    <span class="la-badge @Model.StatusBadgeClass">@Model.StatusDisplayName</span>
                    <strong class="la-price-xl">$@Model.PriceUsd.ToString("N0")</strong>
                </div>

                <h4 class="mt-2 mb-1">@Model.Title (@Model.AreaHectares га)</h4>
                <div class="la-row-between mb-3">
                    <span class="la-meta mb-0">Кадастровий №: <strong>@Model.CadastralNumber</strong></span>
                    <partial name="_DzkLinks" model="Model" />
                </div>

                <table class="la-table mb-3">
                    <tbody>
                        <tr>
                            <td class="text-muted">Власник (Продавець):</td>
                            <td><strong>@Model.Seller?.FullName</strong> (@Model.Seller?.Phone)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Адреса розташування:</td>
                            <td>@Model.Location</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Площа та ціна за сотку:</td>
                            <td><strong>@Model.AreaHectares га</strong> (@Model.AreaSotky соток • $@Model.PricePerSotkaUsd.ToString("N0") / сотка)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Цільове призначення:</td>
                            <td><strong>@Model.Purpose</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Юридичний висновок:</td>
                            <td>
                                @if (Model.LegalConclusion != null)
                                {
                                    <span class="fw-bold @(Model.LegalConclusion.IsApproved ? "text-success" : "text-danger")">
                                        №@Model.LegalConclusion.ConclusionNumber (@Model.LegalConclusion.RiskLevel)
                                    </span>
                                }
                                else
                                {
                                    <span>Очікує правової експертизи ДЗК</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Рієлтор об'єкта:</td>
                            <td>
                                @if (Model.AssignedRealtor != null)
                                {
                                    <strong>@Model.AssignedRealtor.FullName (@Model.AssignedRealtor.Phone, ліц. @Model.AssignedRealtor.LicenseNumber)</strong>
                                }
                                else
                                {
                                    <span>Черговий рієлтор агентства</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="la-subcard">
                    <strong class="la-text-sm">Опис ділянки:</strong>
                    <p class="la-text-sm mt-1 mb-0">@Model.Description</p>
                </div>

                @if (Model.Documents.Any())
                {
                    <div>
                        <strong class="la-text-sm d-block mb-2">Правовстановлюючі документи ділянки (Контроль цілісності):</strong>
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="la-subcard-green la-row-between py-2 px-3 mb-2">
                                <div class="la-text-xs">
                                    <strong>@doc.Title</strong> (@doc.DocType №@doc.DocumentNumber від @doc.IssueDate.ToString("dd.MM.yyyy"))<br />
                                    @if (!string.IsNullOrWhiteSpace(doc.FileHash))
                                    {
                                        <span class="text-muted">SHA-256: <code class="la-code">@doc.ShortFileHash</code></span>
                                    }
                                    @if (doc.IsSignedByKep)
                                    {
                                        <span class="la-badge la-badge-green ms-1">✓ @doc.KepSignatureHash</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(doc.FileUrl))
                                {
                                    <a href="@doc.FileUrl" target="_blank" class="la-btn la-btn-white la-btn-xs">Переглянути файл ↗</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="la-card">
                <h5>Записатися на виїзний огляд</h5>
                @if (Model.IsOwnedBy(User))
                {
                    <div class="la-subcard la-text-sm">
                        Це ваше власне оголошення на продаж. Керувати ціною та документами можна у розділі <a asp-controller="Client" asp-action="Cabinet" class="fw-bold">Мій кабінет</a>.
                    </div>
                }
                else if (Model.Status != LandAgencyMvc.Models.PlotStatus.VerifiedInCatalog)
                {
                    <div class="la-subcard la-text-sm">
                        Запис на виїзний огляд наразі недоступний: ділянка перебуває у статусі <strong>«@Model.StatusDisplayName»</strong>.
                    </div>
                }
                else
                {
                    <p class="la-meta mb-3">Оберіть зручний час виїзду на ділянку для огляду межових знаків, комунікацій та оригіналів документів з рієлтором</p>

                    <form asp-controller="Client" asp-action="CreateViewing" method="post">
                        <input type="hidden" name="landPlotId" value="@Model.Id" />

                        <label class="la-label">Бажана дата огляду</label>
                        <input type="date" name="preferredDate" class="la-input" required />

                        <label class="la-label">Бажаний час</label>
                        <input name="timeSlot" type="time" class="la-input" required />

                        <label class="la-label">Коментар для рієлтора</label>
                        <textarea name="comment" rows="3" class="la-input" placeholder="Вкажіть побажання щодо огляду межових знаків, під'їзної дороги чи комунікацій"></textarea>

                        <button type="submit" class="la-btn la-btn-blue la-btn-full">Подати заявку на огляд</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

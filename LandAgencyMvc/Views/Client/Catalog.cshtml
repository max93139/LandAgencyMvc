@model LandAgencyMvc.Models.CatalogViewModel
@{
    ViewData["Title"] = "Каталог земельних ділянок — LandAgency UA";
    ViewData["ActiveNav"] = "Catalog";
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />
        <div class="la-card">
            <form asp-controller="Client" asp-action="Catalog" method="get" class="la-grid-4">
                <div>
                    <label class="la-label">Цільове призначення</label>
                    <select name="purpose" class="la-input mb-0">
                        <option value="">Усі цільові призначення</option>
                        @foreach (var item in LandAgencyMvc.Models.LandPlot.StandardPurposes)
                        {
                            <option value="@item.Code" selected="@(Model.FilterPurpose == item.Code || Model.FilterPurpose == item.FullValue)">@item.ShortLabel</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="la-label">Макс. бюджет ($)</label>
                    <input name="maxBudget" type="number" value="@Model.FilterMaxBudget" class="la-input mb-0" placeholder="Без обмежень" />
                </div>
                <div>
                    <label class="la-label">Мін. площа (га)</label>
                    <input name="minArea" type="number" step="0.01" value="@Model.FilterMinArea" class="la-input mb-0" placeholder="Від 0.01" />
                </div>
                <div>
                    <label class="la-label">Пошук за локацією / кадастром</label>
                    <div class="la-action-row">
                        <input name="search" value="@Model.FilterSearch" class="la-input mb-0" placeholder="Населений пункт або кадастр" />
                        <button type="submit" class="la-btn la-btn-dark">Знайти</button>
                        @if (Model.HasActiveFilters)
                        {
                            <a class="la-btn la-btn-gray" asp-controller="Client" asp-action="Catalog">Скинути</a>
                        }
                    </div>
                </div>
            </form>
        </div>

        <div class="la-row-between mb-3">
            <div>
                <h4 class="mb-0">Каталог перевірених земельних ділянок</h4>
                <span class="la-meta">Усі ділянки в каталозі пройшли юридичний аудит КОАТУУ у ДЗК та ДРРП</span>
            </div>
            <span class="la-badge la-badge-green">Знайдено пропозицій: @Model.TotalCount</span>
        </div>

        @if (!Model.Plots.Any())
        {
            <div class="la-card">
                <p class="la-meta mb-0">За вибраними критеріями перевірених ділянок у каталозі наразі немає. Ви можете виставити власну ділянку або залишити запит на індивідуальний підбір для рієлтора нижче.</p>
            </div>
        }
        else
        {
            <div class="la-grid-2">
                @foreach (var plot in Model.Plots)
                {
                    <partial name="_PlotCard" model="plot" />
                }
            </div>
        }

        <div class="la-card mt-3">
            <h5>Замовити індивідуальний підбір ділянки (Автоматичний пошук)</h5>
            <p class="la-meta mb-3">Вкажіть бажані параметри земельної ділянки — інтелектуальний двигун AutoMatching миттєво підбере найкращі перевірені варіанти</p>
            <form asp-controller="Client" asp-action="SubmitSelectionRequest" method="post">
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Бажаний район або громада</label>
                        <input name="desiredDistrict" class="la-input" placeholder="Вкажіть район або населений пункт" required />
                    </div>
                    <div>
                        <label class="la-label">Мінімальна площа (га)</label>
                        <input name="minAreaHa" type="number" step="0.01" class="la-input" placeholder="0.00" required />
                    </div>
                    <div>
                        <label class="la-label">Максимальний бюджет (USD)</label>
                        <input name="maxBudgetUsd" type="number" class="la-input" placeholder="0" required />
                    </div>
                </div>
                <label class="la-label">Цільове призначення</label>
                <select name="purpose" class="la-input" required>
                    @foreach (var item in LandAgencyMvc.Models.LandPlot.StandardPurposes)
                    {
                        <option value="@item.FullValue">@item.FullValue</option>
                    }
                </select>
                <button type="submit" class="la-btn la-btn-green">Подати запит на автопідбір ділянок</button>
            </form>
        </div>
    </div>
</div>

@model LandAgencyMvc.Models.CatalogViewModel
@{
    ViewData["Title"] = "Каталог земельних ділянок — LandAgency UA";
    ViewData["ActiveNav"] = "Catalog";
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />
        <div class="la-card">
            <form asp-controller="Client" asp-action="Catalog" method="get">
                <div class="la-grid-4 mb-2">
                    <div>
                        <label class="la-label">Цільове призначення</label>
                        <select name="purpose" class="la-input mb-0">
                            <option value="">Усі цільові призначення</option>
                            @foreach (var item in LandAgencyMvc.Models.LandPlot.StandardPurposes)
                            {
                                <option value="@item.Code" selected="@(Model.FilterPurpose == item.Code || Model.FilterPurpose == item.FullValue)">@item.ShortLabel</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="la-label">Бюджет ($): від / до</label>
                        <div class="la-action-row">
                            <input name="minBudget" type="number" value="@Model.FilterMinBudget" class="la-input mb-0" placeholder="Від $" />
                            <input name="maxBudget" type="number" value="@Model.FilterMaxBudget" class="la-input mb-0" placeholder="До $" />
                        </div>
                    </div>
                    <div>
                        <label class="la-label">Площа (га): від / до</label>
                        <div class="la-action-row">
                            <input name="minArea" type="number" step="0.01" value="@Model.FilterMinArea" class="la-input mb-0" placeholder="Від га" />
                            <input name="maxArea" type="number" step="0.01" value="@Model.FilterMaxArea" class="la-input mb-0" placeholder="До га" />
                        </div>
                    </div>
                    <div>
                        <label class="la-label">Пошук за локацією, кадастром або власником</label>
                        <input name="search" value="@Model.FilterSearch" class="la-input mb-0" placeholder="Київ, Макарів, кадастр або ПІБ" />
                    </div>
                </div>

                <div class="la-grid-4 mb-3">
                    <div>
                        <label class="la-label">Дата лістингу з</label>
                        <input name="from" type="date" value="@(Model.FilterFrom?.ToString("yyyy-MM-dd"))" class="la-input mb-0" />
                    </div>
                    <div>
                        <label class="la-label">Дата лістингу по</label>
                        <input name="to" type="date" value="@(Model.FilterTo?.ToString("yyyy-MM-dd"))" class="la-input mb-0" />
                    </div>
                    <div>
                        <label class="la-label">Впорядкування</label>
                        <select name="sort" class="la-input mb-0">
                            <option value="Date" selected="@(Model.Sort == LandAgencyMvc.Services.PlotSort.Date)">За датою додавання</option>
                            <option value="Price" selected="@(Model.Sort == LandAgencyMvc.Services.PlotSort.Price)">За загальною ціною ($)</option>
                            <option value="PricePerSotka" selected="@(Model.Sort == LandAgencyMvc.Services.PlotSort.PricePerSotka)">За ціною за сотку ($/сот.)</option>
                            <option value="Area" selected="@(Model.Sort == LandAgencyMvc.Services.PlotSort.Area)">За площею (га)</option>
                            <option value="Title" selected="@(Model.Sort == LandAgencyMvc.Services.PlotSort.Title)">За назвою ділянки</option>
                            <option value="Location" selected="@(Model.Sort == LandAgencyMvc.Services.PlotSort.Location)">За населеним пунктом</option>
                        </select>
                    </div>
                    <div>
                        <label class="la-label">Напрямок сортування</label>
                        <div class="la-action-row">
                            <select name="desc" class="la-input mb-0">
                                <option value="true" selected="@Model.Descending">За спаданням (↓)</option>
                                <option value="false" selected="@(!Model.Descending)">За зростанням (↑)</option>
                            </select>
                            <button type="submit" class="la-btn la-btn-dark">Фільтрувати</button>
                            @if (Model.HasActiveFilters)
                            {
                                <a class="la-btn la-btn-gray" asp-controller="Client" asp-action="Catalog">Скинути</a>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="la-row-between mb-3">
            <div>
                <h4 class="mb-0">Каталог перевірених земельних ділянок</h4>
                <span class="la-meta">Усі ділянки в каталозі пройшли юридичний аудит КОАТУУ у ДЗК та ДРРП</span>
            </div>
            <span class="la-badge la-badge-green">Знайдено пропозицій: @Model.TotalCount</span>
        </div>

        @if (!Model.Plots.Any())
        {
            <div class="la-card">
                <p class="la-meta mb-0">За вибраними критеріями перевірених ділянок у каталозі наразі немає. Ви можете виставити власну ділянку або залишити запит на індивідуальний підбір для рієлтора нижче.</p>
            </div>
        }
        else
        {
            <div class="la-grid-2">
                @foreach (var plot in Model.Plots)
                {
                    <partial name="_PlotCard" model="plot" />
                }
            </div>
        }

        <div class="la-card mt-3">
            <h5>Замовити індивідуальний підбір ділянки</h5>
            <p class="la-meta mb-3">Вкажіть бажані параметри земельної ділянки — інтелектуальний двигун AutoMatching миттєво підбере найкращі перевірені варіанти</p>
            <form asp-controller="Client" asp-action="SubmitSelectionRequest" method="post">
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Бажаний район або громада</label>
                        <input name="desiredDistrict" class="la-input" placeholder="Вкажіть район або населений пункт" required />
                    </div>
                    <div>
                        <label class="la-label">Мінімальна площа (га)</label>
                        <input name="minAreaHa" type="number" step="0.01" class="la-input" placeholder="0.00" required />
                    </div>
                    <div>
                        <label class="la-label">Максимальний бюджет (USD)</label>
                        <input name="maxBudgetUsd" type="number" class="la-input" placeholder="0" required />
                    </div>
                </div>
                <label class="la-label">Цільове призначення</label>
                <select name="purpose" class="la-input" required>
                    @foreach (var item in LandAgencyMvc.Models.LandPlot.StandardPurposes)
                    {
                        <option value="@item.FullValue">@item.FullValue</option>
                    }
                </select>
                <button type="submit" class="la-btn la-btn-green">Подати запит на автопідбір ділянок</button>
            </form>
        </div>
    </div>
</div>

@model LandAgencyMvc.Models.CabinetViewModel
@{
    ViewData["Title"] = "Мій кабінет — LandAgency UA";
    ViewData["ActiveNav"] = "Cabinet";
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-grid-2">
            @if (Model.IsSeller)
            {
                <partial name="_SellerCabinet" model="Model" />
            }
            else
            {
                <partial name="_BuyerCabinet" model="Model" />
            }
        </div>
    </div>
</div>

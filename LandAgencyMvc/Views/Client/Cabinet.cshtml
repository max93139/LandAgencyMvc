@model LandAgencyMvc.Models.CabinetViewModel
@{
    ViewData["Title"] = "Мій кабінет — LandAgency UA";
    ViewData["ActiveNav"] = "Cabinet";
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-grid-2">
            <div>
                <div class="la-card">
                    <h5>Мої оголошення на продаж (Мої ділянки)</h5>
                    @if (!Model.MyPlots.Any())
                    {
                        <p class="la-meta mb-0">Ви ще не виставляли власних земельних ділянок на продаж.</p>
                    }
                    else
                    {
                        @foreach (var myPlot in Model.MyPlots)
                        {
                            <div class="la-subcard">
                                <div class="la-row-between">
                                    <div>
                                        <strong>@myPlot.CadastralNumber (@myPlot.AreaHectares га, @myPlot.Title)</strong>
                                        <span class="la-badge @myPlot.StatusBadgeClass ms-1">@myPlot.StatusDisplayName</span>
                                    </div>
                                    @if (myPlot.Status != LandAgencyMvc.Models.PlotStatus.Sold)
                                    {
                                        <form asp-controller="Client" asp-action="UpdatePlotPrice" method="post" class="la-inline-form">
                                            <input type="hidden" name="plotId" value="@myPlot.Id" />
                                            <input type="number" name="newPriceUsd" value="@myPlot.PriceUsd" class="la-input-inline" required />
                                            <button type="submit" class="la-btn la-btn-blue la-btn-sm">Оновити ціну</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <strong class="la-price-md">$@myPlot.PriceUsd.ToString("N0")</strong>
                                    }
                                </div>
                                <div class="la-text-xs mt-1">
                                    Призначення: @myPlot.Purpose • IBAN: @myPlot.EffectiveSellerIban
                                </div>
                                @if (myPlot.LegalConclusion != null)
                                {
                                    <div class="la-text-xs mt-1 @(myPlot.LegalConclusion.IsApproved ? "text-success" : "text-danger") fw-bold">
                                        Висновок юриста №@myPlot.LegalConclusion.ConclusionNumber: @myPlot.LegalConclusion.ConclusionText
                                    </div>
                                }
                                @if (myPlot.Documents.Any())
                                {
                                    <div class="mt-2">
                                        @foreach (var doc in myPlot.Documents)
                                        {
                                            <div class="la-subcard py-2 px-3 mb-1">
                                                <div class="la-row-between">
                                                    <div>
                                                        <span class="la-badge @(doc.IsVerified ? "la-badge-green" : "la-badge-indigo")">
                                                            📄 @doc.DocType №@doc.DocumentNumber
                                                        </span>
                                                        @if (doc.IsSignedByKep)
                                                        {
                                                            <span class="la-badge la-badge-green" title="Підписано: @doc.SignerFullName, РНОКПП: @doc.SignerTaxId">КЕП ✓ @doc.SignerFullName</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(doc.FileUrl))
                                                    {
                                                        <a href="@doc.FileUrl" target="_blank" class="la-btn la-btn-white la-btn-xs">Переглянути файл ↗</a>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(doc.FileHash))
                                                {
                                                    <div class="la-code mt-1">
                                                        SHA-256: @doc.FileHash
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (myPlot.Status != LandAgencyMvc.Models.PlotStatus.Sold)
                                {
                                    <details class="mt-2 la-text-xs">
                                        <summary class="fw-bold text-primary">➕ Додати правовстановлюючий документ або витяг ДЗК</summary>
                                        <form asp-controller="Client" asp-action="AddPlotDocument" method="post" enctype="multipart/form-data" class="la-subcard mt-2 mb-0">
                                            <input type="hidden" name="plotId" value="@myPlot.Id" />
                                            <div class="la-grid-2">
                                                <div>
                                                    <label class="la-label">Тип документа</label>
                                                    <select name="docType" class="la-input">
                                                        <option value="Витяг з ДРРП про право власності">Витяг з ДРРП про право власності</option>
                                                        <option value="Витяг з Державного земельного кадастру">Витяг з ДЗК</option>
                                                        <option value="Державний акт на право власності на землю">Державний акт на право власності</option>
                                                        <option value="Технічна документація із землеустрою">Технічна документація із землеустрою</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="la-label">Реєстраційний № документа</label>
                                                    <input name="documentNumber" class="la-input" placeholder="Номер документа" required />
                                                </div>
                                            </div>
                                            <div class="la-row-between">
                                                <input type="file" name="documentFile" class="la-input-inline" />
                                                <div class="la-action-row">
                                                    <label class="fw-bold text-success">
                                                        <input type="checkbox" name="signWithKep" value="true" checked /> Накласти КЕП
                                                    </label>
                                                    <button type="submit" class="la-btn la-btn-green la-btn-xs">Завантажити</button>
                                                </div>
                                            </div>
                                        </form>
                                    </details>
                                }
                            </div>
                        }
                    }
                </div>

                @if (Model.MySelectionRequests.Any())
                {
                    <div class="la-card">
                        <h5>Мої запити на індивідуальний підбір ділянки</h5>
                        @foreach (var req in Model.MySelectionRequests)
                        {
                            <div class="la-subcard">
                                <div class="la-row-between">
                                    <strong>@req.DesiredDistrict (від @req.MinAreaHa га, до $@req.MaxBudgetUsd.ToString("N0"))</strong>
                                    <span class="la-badge @(req.IsProcessedByRealtor ? "la-badge-green" : "la-badge-amber")">
                                        @(req.IsProcessedByRealtor ? "Підбір надіслано ✓" : "В обробці")
                                    </span>
                                </div>
                                <div class="la-meta">@req.Purpose</div>
                                @if (!string.IsNullOrEmpty(req.RealtorNotes))
                                {
                                    <div class="la-text-sm fw-bold text-success mt-1">Рієлтор: @req.RealtorNotes</div>
                                }
                            </div>
                        }
                        @if (Model.MatchedPlotsForUser.Any())
                        {
                            <strong class="la-text-sm d-block mb-2">Підібрані для вас варіанти ділянок:</strong>
                            @foreach (var mp in Model.MatchedPlotsForUser)
                            {
                                <div class="la-subcard-green la-row-between py-2 px-3 mb-2">
                                    <span><strong>@mp.Title</strong> (@mp.CadastralNumber) — $@mp.PriceUsd.ToString("N0")</span>
                                    <a asp-controller="Client" asp-action="Details" asp-route-id="@mp.Id" class="la-btn la-btn-green la-btn-xs">Переглянути →</a>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <div>
                <div class="la-card">
                    <h5>Мої заявки на огляд та Активні покупки</h5>
                    @if (!Model.MyViewings.Any())
                    {
                        <p class="la-meta">Активних заявок на огляд ділянок немає.</p>
                    }
                    else
                    {
                        @foreach (var v in Model.MyViewings)
                        {
                            <div class="la-subcard">
                                <div class="la-row-between">
                                    <span>• Заявка на огляд ділянки <strong>@v.LandPlot?.CadastralNumber</strong> (@v.LandPlot?.Title)</span>
                                    <span class="la-badge @v.StatusBadgeClass">@v.StatusDisplayName</span>
                                </div>
                                <div class="la-meta mt-1">
                                    Дата виїзду: @v.PreferredDate.ToString("dd.MM.yyyy") о @v.TimeSlot
                                    @if (!string.IsNullOrEmpty(v.ResultNotes))
                                    {
                                        <span> • @v.ResultNotes</span>
                                    }
                                </div>
                                <div class="la-action-row mt-2">
                                    @if (Model.CanRequestPurchase(v))
                                    {
                                        <form asp-controller="Client" asp-action="RequestPurchaseFromViewing" method="post">
                                            <input type="hidden" name="viewingId" value="@v.Id" />
                                            <button type="submit" class="la-btn la-btn-green la-btn-sm">Подати заявку на купівлю ділянки</button>
                                        </form>
                                    }
                                    else if (v.Status == LandAgencyMvc.Models.ViewingStatus.Completed && Model.HasActiveDealForPlot(v.LandPlotId))
                                    {
                                        <span class="la-badge la-badge-indigo">Угоду сформовано ✓</span>
                                    }
                                    @if (v.CanCancelByClient)
                                    {
                                        <form asp-controller="Client" asp-action="CancelViewingByClient" method="post">
                                            <input type="hidden" name="viewingId" value="@v.Id" />
                                            <button type="submit" class="la-btn la-btn-red la-btn-sm">Скасувати огляд</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    }

                    @foreach (var d in Model.MyDeals)
                    {
                        <div class="@d.SubcardClass mt-3">
                            <div class="la-row-between">
                                <strong>Угода купівлі №@d.DraftContractNumber (Ділянка @d.LandPlot?.CadastralNumber, @d.LandPlot?.Title)</strong>
                                <span class="la-badge @d.StatusBadgeClass">@d.StatusDisplayName</span>
                            </div>
                            <p class="la-text-xs my-1">
                                Продавець: @d.LandPlot?.Seller?.FullName • IBAN: @d.LandPlot?.EffectiveSellerIban • Сума: <strong>$@d.FinalPriceUsd.ToString("N0")</strong> (+ комісія $@d.AgencyCommissionUsd.ToString("N0"))
                            </p>
                            <p class="la-text-xs mb-2">
                                Нотаріус: @d.NotaryOffice • Дата: @d.NotaryDate.ToString("dd.MM.yyyy HH:mm")
                                @if (!string.IsNullOrEmpty(d.NotarialRegistryNumber))
                                {
                                    <span> • Реєстровий №: <strong>@d.NotarialRegistryNumber</strong></span>
                                }
                            </p>

                            <div class="la-subcard bg-white mb-2">
                                <strong class="la-text-xs d-block mb-2">Рахунки та банківські платежі:</strong>
                                @foreach (var p in d.Payments)
                                {
                                    <div class="border-bottom pb-2 mb-2 la-text-xs">
                                        <div class="la-row-between">
                                            <div>
                                                <strong>@p.PaymentType</strong> (Рахунок №@p.InvoiceNumber)
                                                <div class="text-muted">IBAN одержувача: <code>@p.RecipientIban</code></div>
                                            </div>
                                            <div class="text-end">
                                                <strong>$@p.AmountUsd.ToString("N2")</strong>
                                                <div>
                                                    <span class="la-badge @p.StatusBadgeClass">@p.StatusDisplayName</span>
                                                    @if (!string.IsNullOrEmpty(p.PaymentReference))
                                                    {
                                                        <span class="la-text-xs">(Ref: @p.PaymentReference)</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        @if (p.CanSubmitByClient)
                                        {
                                            <form asp-controller="Client" asp-action="SubmitPayment" method="post" class="la-inline-form mt-2">
                                                <input type="hidden" name="paymentId" value="@p.Id" />
                                                <input type="text" name="paymentReference" class="la-input-inline" placeholder="Код квитанції / референс (напр. TRX-12345)" required />
                                                <input type="text" name="senderIban" class="la-input-inline text-uppercase" placeholder="Ваш IBAN" value="@Model.CurrentUser?.BankDetails" maxlength="29" minlength="29" pattern="^UA[0-9]{27}$" title="Формат IBAN: UA та 27 цифр" />
                                                <button type="submit" class="la-btn la-btn-green la-btn-xs">Повідомити про оплату</button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="la-action-row">
                                <a class="la-btn la-btn-white la-btn-sm" asp-controller="Client" asp-action="DownloadReceipt" asp-route-dealId="@d.Id" target="_blank">Квитанція та рахунки</a>
                                <a class="la-btn la-btn-link la-btn-sm" asp-controller="Realtor" asp-action="PrintContract" asp-route-dealId="@d.Id" target="_blank">Текст договору</a>
                            </div>
                        </div>
                    }

                    @if (Model.MySellerDeals.Any())
                    {
                        <hr />
                        <h6>Угоди з продажу моїх ділянок:</h6>
                        @foreach (var sd in Model.MySellerDeals)
                        {
                            <div class="la-subcard mt-2">
                                <div class="la-row-between">
                                    <strong>Угода №@sd.DraftContractNumber — Ділянка @sd.LandPlot?.CadastralNumber</strong>
                                    <span class="la-badge @sd.StatusBadgeClass">@sd.StatusDisplayName</span>
                                </div>
                                <div class="la-text-sm mt-1">Покупець: @sd.Buyer?.FullName • Сума: $@sd.FinalPriceUsd.ToString("N0") • Оплата: @(sd.IsFullyPaid ? "Оплачено повністю ✓" : "Очікує надходження коштів")</div>
                                @if (sd.Payments.Any())
                                {
                                    <div class="la-text-xs mt-1">
                                        @foreach (var p in sd.Payments)
                                        {
                                            <div class="mb-1">
                                                • @p.PaymentType ($@p.AmountUsd.ToString("N2")):
                                                <span class="la-badge @p.StatusBadgeClass">@p.StatusDisplayName</span>
                                                @if (!string.IsNullOrEmpty(p.PaymentReference))
                                                {
                                                    <span>(Ref: @p.PaymentReference)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="la-action-row mt-2">
                                    <a class="la-btn la-btn-white la-btn-xs" asp-controller="Client" asp-action="DownloadReceipt" asp-route-dealId="@sd.Id" target="_blank">Квитанція та рахунки</a>
                                    <a class="la-btn la-btn-link la-btn-xs" asp-controller="Realtor" asp-action="PrintContract" asp-route-dealId="@sd.Id" target="_blank">Текст договору</a>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="la-card">
                    <h6>Налаштування профілю, РНОКПП (ІПН), IBAN та пароль</h6>
                    <form asp-controller="Client" asp-action="ChangePassword" method="post">
                        <div class="la-grid-2">
                            <div>
                                <label class="la-label">РНОКПП (ІПН) для угод</label>
                                <input name="taxId" value="@Model.CurrentUser?.TaxId" class="la-input" placeholder="10 цифр" />
                            </div>
                            <div>
                                <label class="la-label">Мій банківський рахунок IBAN</label>
                                <input name="bankDetails" value="@Model.CurrentUser?.BankDetails" class="la-input text-uppercase" placeholder="UAXXXXXXXXXXXXXXXXXXXXXXXXXXX" maxlength="29" minlength="29" pattern="^UA[0-9]{27}$" title="Формат IBAN України: UA та 27 цифр (рівно 29 символів)" />
                            </div>
                        </div>
                        <div class="la-grid-2">
                            <div>
                                <label class="la-label">Поточний пароль</label>
                                <input type="password" name="currentPassword" class="la-input" placeholder="Для зміни пароля" />
                            </div>
                            <div>
                                <label class="la-label">Новий пароль</label>
                                <input type="password" name="newPassword" class="la-input" placeholder="Новий пароль" />
                            </div>
                        </div>
                        <button type="submit" class="la-btn la-btn-dark la-btn-sm">Зберегти дані профілю</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

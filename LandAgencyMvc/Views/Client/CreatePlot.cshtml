@model LandAgencyMvc.Models.LandPlot
@{
    ViewData["Title"] = "Виставити ділянку на продаж — LandAgency UA";
    var currentUser = ViewBag.CurrentUser as LandAgencyMvc.Models.AppUser;
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <div class="la-card" style="max-width:820px; margin:0 auto;">
            <h4>Нове оголошення: Виставити земельну ділянку на продаж</h4>
            <p class="text-muted" style="font-size:13px; margin-bottom:18px;">Після подачі анкети та документа юрист проведе перевірку КОАТУУ в ДЗК та ДРРП перед публікацією в каталозі</p>

            <partial name="_AlertMessages" />

            <form asp-controller="Client" asp-action="CreatePlot" method="post" enctype="multipart/form-data">
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Кадастровий номер (КОАТУУ)</label>
                        <input asp-for="CadastralNumber" class="la-input" placeholder="XXXXXXXXXX:XX:XXX:XXXX" required />
                    </div>
                    <div>
                        <label class="la-label">Площа (га)</label>
                        <input asp-for="AreaHectares" type="number" step="0.01" value="" class="la-input" placeholder="0.00" required />
                    </div>
                    <div>
                        <label class="la-label">Ціна продажу ($)</label>
                        <input asp-for="PriceUsd" type="number" value="" class="la-input" placeholder="0" required />
                    </div>
                </div>

                <div class="la-grid-2">
                    <div>
                        <label class="la-label">Назва оголошення</label>
                        <input asp-for="Title" class="la-input" placeholder="Коротка назва земельної ділянки" required />
                    </div>
                    <div>
                        <label class="la-label">Цільове призначення (за КВЦПЗ)</label>
                        <select asp-for="Purpose" class="la-input" required>
                            <option value="02.01 Для будівництва житлового будинку">02.01 Для будівництва житлового будинку</option>
                            <option value="01.01 Для ведення товарного сільськогосподарського виробництва">01.01 Для ведення товарного сільськогосподарського виробництва</option>
                            <option value="01.03 Для ведення особистого селянського господарства">01.03 Для ведення особистого селянського господарства</option>
                            <option value="03.07 Для будівництва та обслуговування об'єктів торгівлі">03.07 Для будівництва та обслуговування об'єктів торгівлі</option>
                            <option value="01.05 Для індивідуального садівництва">01.05 Для індивідуального садівництва</option>
                        </select>
                    </div>
                </div>

                <div class="la-grid-2">
                    <div>
                        <label class="la-label">Адреса розташування</label>
                        <input asp-for="Location" class="la-input" placeholder="Область, район, населений пункт, вулиця" required />
                    </div>
                    <div>
                        <label class="la-label">Банківський рахунок IBAN (для отримання коштів від покупця)</label>
                        <input asp-for="SellerBankIban" class="la-input" placeholder="UAXXXXXXXXXXXXXXXXXXXXXXXXXXX" maxlength="29" minlength="29" pattern="^UA[0-9]{27}$" title="Формат IBAN України: UA та 27 цифр (рівно 29 символів)" style="text-transform:uppercase;" required />
                    </div>
                </div>

                <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:10px; padding:16px; margin-bottom:16px;">
                    <h6 style="margin-top:0; margin-bottom:10px;">Правовстановлюючий документ (Витяг з ДРРП або Державний акт)</h6>
                    <div class="la-grid-3">
                        <div>
                            <label class="la-label">Тип документа</label>
                            <select name="docType" class="la-input">
                                <option value="Витяг з ДРРП про право власності">Витяг з ДРРП про право власності</option>
                                <option value="Державний акт на право власності на землю">Державний акт на право власності</option>
                                <option value="Витяг з Державного земельного кадастру">Витяг з ДЗК</option>
                            </select>
                        </div>
                        <div>
                            <label class="la-label">Реєстраційний № документа</label>
                            <input asp-for="OwnershipDocNumber" class="la-input" placeholder="Індексний номер витягу" required />
                        </div>
                        <div>
                            <label class="la-label">Дата видачі</label>
                            <input type="date" name="docIssueDate" class="la-input" />
                        </div>
                    </div>
                    <div class="la-grid-2" style="align-items:center;">
                        <div>
                            <label class="la-label">Файл документа (PDF / Скан — цілісність SHA-256)</label>
                            <input type="file" name="documentFile" class="la-input" style="margin-bottom:0;" />
                        </div>
                        <div style="padding-top:16px;">
                            <label style="display:flex; align-items:center; gap:8px; background:#dcfce7; color:#166534; padding:10px 14px; border-radius:8px; font-weight:700; font-size:13px; cursor:pointer;">
                                <input type="checkbox" name="signWithKep" value="true" checked />
                                ✓ Засвідчити файл КЕП (SHA-256 + РНОКПП)
                            </label>
                        </div>
                    </div>
                </div>

                <label class="la-label">Опис ділянки та наявних комунікацій</label>
                <textarea asp-for="Description" rows="3" class="la-input" placeholder="Рельєф, асфальтований під'їзд, електромережа, газ, винесення меж у натуру" required></textarea>

                <button type="submit" class="la-btn la-btn-green" style="width:100%;">Опублікувати та відправити на перевірку в ДЗК</button>
            </form>
        </div>
    </div>
</div>

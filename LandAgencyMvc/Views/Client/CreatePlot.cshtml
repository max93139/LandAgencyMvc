@model LandAgencyMvc.Models.LandPlot
@{
    ViewData["Title"] = "Виставити ділянку на продаж — LandAgency UA";
}

<div class="la-window">
    <partial name="_ClientNavbar" />

    <div class="la-body">
        <div class="la-card">
            <h4>Нове оголошення: Виставити земельну ділянку на продаж</h4>
            <p class="la-meta mb-3">Після подачі анкети та документа юрист проведе перевірку КОАТУУ в ДЗК та ДРРП перед публікацією в каталозі</p>

            <partial name="_AlertMessages" />

            <form asp-controller="Client" asp-action="CreatePlot" method="post" enctype="multipart/form-data">
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Кадастровий номер (КОАТУУ)</label>
                        <input asp-for="CadastralNumber" class="la-input" placeholder="XXXXXXXXXX:XX:XXX:XXXX" required />
                    </div>
                    <div>
                        <label class="la-label">Площа (га)</label>
                        <input asp-for="AreaHectares" type="number" step="0.01" value="@(Model.AreaHectares > 0 ? Model.AreaHectares : "")" class="la-input" placeholder="0.00" required />
                    </div>
                    <div>
                        <label class="la-label">Ціна продажу ($)</label>
                        <input asp-for="PriceUsd" type="number" value="@(Model.PriceUsd > 0 ? Model.PriceUsd : "")" class="la-input" placeholder="0" required />
                    </div>
                </div>

                <div class="la-grid-2">
                    <div>
                        <label class="la-label">Назва оголошення</label>
                        <input asp-for="Title" class="la-input" placeholder="Коротка назва земельної ділянки" required />
                    </div>
                    <div>
                        <label class="la-label">Цільове призначення (за КВЦПЗ)</label>
                        <select asp-for="Purpose" class="la-input" required>
                            @foreach (var item in LandAgencyMvc.Models.LandPlot.StandardPurposes)
                            {
                                <option value="@item.FullValue">@item.FullValue</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="la-grid-2">
                    <div>
                        <label class="la-label">Адреса розташування</label>
                        <input asp-for="Location" class="la-input" placeholder="Область, район, населений пункт, вулиця" required />
                    </div>
                    <div>
                        <label class="la-label">Банківський рахунок IBAN (для отримання коштів від покупця)</label>
                        <input asp-for="SellerBankIban" class="la-input text-uppercase" placeholder="UAXXXXXXXXXXXXXXXXXXXXXXXXXXX" maxlength="29" minlength="29" pattern="^UA[0-9]{27}$" title="Формат IBAN України: UA та 27 цифр (рівно 29 символів)" required />
                    </div>
                </div>

                <div class="la-subcard">
                    <h6 class="mt-0 mb-2">Правовстановлюючий документ (Витяг з ДРРП або Державний акт)</h6>
                    <div class="la-grid-3">
                        <div>
                            <label class="la-label">Тип документа</label>
                            <select name="docType" class="la-input">
                                <option value="Витяг з ДРРП про право власності">Витяг з ДРРП про право власності</option>
                                <option value="Державний акт на право власності на землю">Державний акт на право власності</option>
                                <option value="Витяг з Державного земельного кадастру">Витяг з ДЗК</option>
                            </select>
                        </div>
                        <div>
                            <label class="la-label">Реєстраційний № документа</label>
                            <input asp-for="OwnershipDocNumber" class="la-input" placeholder="Індексний номер витягу" required />
                        </div>
                        <div>
                            <label class="la-label">Дата видачі</label>
                            <input type="date" name="docIssueDate" class="la-input" />
                        </div>
                    </div>
                    <div class="la-grid-2 align-items-center">
                        <div>
                            <label class="la-label">Файл документа (PDF / Скан — цілісність SHA-256)</label>
                            <input type="file" name="documentFile" class="la-input mb-0" />
                        </div>
                        <div class="pt-3">
                            <label class="la-check-item mb-0 fw-bold text-success">
                                <input type="checkbox" name="signWithKep" value="true" checked />
                                ✓ Засвідчити файл КЕП (SHA-256 + РНОКПП)
                            </label>
                        </div>
                    </div>
                </div>

                <label class="la-label">Опис ділянки та наявних комунікацій</label>
                <textarea asp-for="Description" rows="3" class="la-input" placeholder="Рельєф, асфальтований під'їзд, електромережа, газ, винесення меж у натуру" required></textarea>

                <button type="submit" class="la-btn la-btn-green la-btn-full">Опублікувати та відправити на перевірку в ДЗК</button>
            </form>
        </div>
    </div>
</div>

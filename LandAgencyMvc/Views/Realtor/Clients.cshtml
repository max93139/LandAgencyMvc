@model LandAgencyMvc.Models.UsersManagementViewModel
@{
    ViewData["Title"] = "Клієнти та персонал — LandAgency UA";
    ViewData["ActiveNav"] = "Clients";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-grid-2 mb-3">
            <div class="la-card">
                <h4 class="mb-2">Перевірка пароля</h4>
                <p class="la-meta mb-3">Безпечна перевірка облікових даних користувача методом POST без збереження відкритого тексту пароля</p>

                <form method="post" asp-controller="Realtor" asp-action="VerifyClientPassword">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="la-label">Електронна пошта клієнта</label>
                        <input name="checkEmail" type="email" class="la-input mb-0" placeholder="client@example.com" value="@(Model.SearchEmail ?? Model.CheckPasswordEmail)" required />
                    </div>
                    <div class="mb-3">
                        <label class="la-label">Введений пароль</label>
                        <input name="password" type="password" class="la-input mb-0" placeholder="Введіть пароль для перевірки хешу" required />
                    </div>
                    <button type="submit" class="la-btn la-btn-dark la-btn-full">Перевірити автентичність пароля</button>
                </form>
            </div>

            <div class="la-card">
                <h4 class="mb-2">Реєстрація нового клієнта в агентстві</h4>
                <p class="la-meta mb-3">Створення картки клієнта та його початкової заявки на пошук у межах єдиної транзакції БД</p>

                <form method="post" asp-controller="Realtor" asp-action="AddClient">
                    @Html.AntiForgeryToken()
                    <div class="la-grid-2 mb-2">
                        <div>
                            <label class="la-label">ПІБ клієнта</label>
                            <input name="FullName" class="la-input mb-0" placeholder="Шевченко Тарас Григорович" required />
                        </div>
                        <div>
                            <label class="la-label">Електронна пошта</label>
                            <input name="Email" type="email" class="la-input mb-0" placeholder="taras@shevchenko.ua" required />
                        </div>
                    </div>
                    <div class="la-grid-2 mb-2">
                        <div>
                            <label class="la-label">Контактний телефон</label>
                            <input name="Phone" class="la-input mb-0" placeholder="+380..." />
                        </div>
                        <div>
                            <label class="la-label">Пароль облікового запису</label>
                            <input name="Password" type="password" class="la-input mb-0" placeholder="Мінімум 4 символи" required />
                        </div>
                    </div>
                    <div class="la-grid-2 mb-3">
                        <div>
                            <label class="la-label">Роль у системі</label>
                            <select name="Role" class="la-input mb-0">
                                <option value="Client" selected>Клієнт</option>
                                <option value="Realtor">Рієлтор</option>
                                <option value="Lawyer">Юрист</option>
                            </select>
                        </div>
                        <div>
                            <label class="la-label">Банківські реквізити IBAN</label>
                            <input name="BankDetails" class="la-input mb-0" placeholder="UA..." />
                        </div>
                    </div>
                    <button type="submit" class="la-btn la-btn-green la-btn-full">+ Зареєструвати клієнта</button>
                </form>
            </div>
        </div>

        <div class="la-card">
            <div class="la-row-between mb-3">
                <div>
                    <h4 class="mb-1">База клієнтів та персоналу агентства</h4>
                    <span class="la-meta">Всього облікових записів у системі: <strong>@Model.Users.Count</strong></span>
                </div>
                <form method="get" asp-controller="Realtor" asp-action="Clients" class="la-action-row">
                    <input name="searchEmail" type="email" class="la-input mb-0" placeholder="Пошук за Email..." value="@Model.SearchEmail" />
                    <button type="submit" class="la-btn la-btn-dark la-btn-sm">Знайти</button>
                    @if (!string.IsNullOrEmpty(Model.SearchEmail))
                    {
                        <a class="la-btn la-btn-gray la-btn-sm" asp-controller="Realtor" asp-action="Clients">Скинути</a>
                    }
                </form>
            </div>

            <table class="la-table">
                <thead>
                    <tr>
                        <th class="text-center">ID</th>
                        <th>Користувач / Співробітник</th>
                        <th>Роль</th>
                        <th>Контакти та IBAN</th>
                        <th class="text-center">Ділянки</th>
                        <th class="text-center">Стан</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var hasHistory = u.OwnedPlots.Any();
                        var isAdmin = u.Email.Contains("admin", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td class="text-center">#@u.Id</td>
                            <td>
                                <strong>@u.FullName</strong>
                                <br />
                                <span class="la-meta">@u.Email</span>
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="la-badge la-badge-red">Адміністратор</span>
                                }
                                else
                                {
                                    @switch (u.Role)
                                    {
                                        case LandAgencyMvc.Models.UserRole.Realtor:
                                            <span class="la-badge la-badge-amber">Рієлтор</span>
                                            break;
                                        case LandAgencyMvc.Models.UserRole.Lawyer:
                                            <span class="la-badge la-badge-indigo">Юрист</span>
                                            break;
                                        default:
                                            <span class="la-badge la-badge-green">Клієнт</span>
                                            break;
                                    }
                                }
                            </td>
                            <td>
                                <div>@(string.IsNullOrEmpty(u.Phone) ? "—" : u.Phone)</div>
                                @if (!string.IsNullOrEmpty(u.BankDetails))
                                {
                                    <span class="la-meta">IBAN: @u.BankDetails</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.OwnedPlots.Any())
                                {
                                    <span class="la-badge la-badge-green">@u.OwnedPlots.Count діл.</span>
                                }
                                else
                                {
                                    <span class="la-meta">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive)
                                {
                                    <span class="la-badge la-badge-green">Активний</span>
                                }
                                else
                                {
                                    <span class="la-badge la-badge-red">Заблокований</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="la-action-row justify-content-end mb-2">
                                    <button class="la-btn la-btn-outline la-btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editUser_@u.Id">
                                        Редагувати ▾
                                    </button>

                                    @if (isAdmin)
                                    {
                                        <span class="la-meta ms-2">Системний</span>
                                    }
                                    else if (hasHistory)
                                    {
                                        <span class="la-badge la-badge-amber ms-2" title="Неможливо вилучити: користувач має історію угод або ділянок">
                                            Має історію
                                        </span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-controller="Realtor" asp-action="DeleteClient" onsubmit="return confirm('Вилучити користувача @u.FullName з бази даних?');" class="d-inline ms-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="la-btn la-btn-danger la-btn-sm">Вилучити</button>
                                        </form>
                                    }
                                </div>

                                <div class="collapse text-start" id="editUser_@u.Id">
                                    <div class="la-card p-3 mb-0 bg-light">
                                        <h6>Редагування користувача #@u.Id</h6>
                                        <form method="post" asp-controller="Realtor" asp-action="UpdateClient">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@u.Id" />
                                            <div class="mb-2">
                                                <label class="la-label">ПІБ</label>
                                                <input name="FullName" value="@u.FullName" class="la-input mb-0" required />
                                            </div>
                                            <div class="mb-2">
                                                <label class="la-label">Телефон</label>
                                                <input name="Phone" value="@u.Phone" class="la-input mb-0" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="la-label">Новий пароль (за потреби)</label>
                                                <input name="NewPassword" type="password" class="la-input mb-0" placeholder="Залиште порожнім, щоб не змінювати" />
                                            </div>
                                            <div class="mb-2">
                                                <label>
                                                    <input type="checkbox" name="IsActive" value="true" @(u.IsActive ? "checked" : "") />
                                                    Активний обліковий запис
                                                </label>
                                            </div>
                                            <div class="la-action-row">
                                                <button type="submit" class="la-btn la-btn-dark la-btn-sm">Зберегти зміни</button>
                                                <button class="la-btn la-btn-gray la-btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editUser_@u.Id">Скасувати</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model LandAgencyMvc.Models.PlotCreateViewModel
@{
    ViewData["Title"] = "Нова земельна ділянка";
    ViewData["ActiveNav"] = "Plots";
}

<div class="container-fluid px-0">
    <div class="la-page-header">
        <div>
            <div class="mb-2">
                <a asp-action="Plots" class="text-decoration-none">&larr; Повернутися до реєстру ділянок</a>
            </div>
            <h1 class="la-page-title">Реєстрація нової земельної ділянки</h1>
            <p class="la-meta mb-0">Внесення параметрів об'єкта, банківських реквізитів продавця та первинного правовстановлюючого документа</p>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <form method="post" asp-action="CreatePlot">
        @Html.AntiForgeryToken()

        <partial name="_PlotFormFields" model="Model" />

        <div class="la-card mb-4">
            <h3 class="la-card-title mb-3">Первинний правовстановлюючий документ</h3>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DocTitle" class="la-label"></label>
                    <input asp-for="DocTitle" class="la-input" placeholder="Витяг з ДРРП про реєстрацію права власності" />
                    <span asp-validation-for="DocTitle" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DocType" class="la-label"></label>
                    <input asp-for="DocType" class="la-input" value="Витяг з ДРРП" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DocIssueDate" class="la-label"></label>
                    <input asp-for="DocIssueDate" type="date" class="la-input" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="la-btn la-btn-dark">Зареєструвати ділянку</button>
            <a asp-action="Plots" class="la-btn la-btn-outline">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

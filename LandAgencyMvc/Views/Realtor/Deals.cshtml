@model LandAgencyMvc.Models.RealtorDealsViewModel
@{
    ViewData["Title"] = "Супровід угод та Нотаріат — Панель Рієлтора";
    ViewData["ActiveNav"] = "Deals";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-card">
            <h5>Підготувати новий проєкт договору купівлі-продажу</h5>
            <form asp-controller="Realtor" asp-action="CreateDeal" method="post">
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Земельна ділянка</label>
                        <select name="landPlotId" class="la-input" required>
                            @if (!Model.AvailablePlots.Any())
                            {
                                <option value="0">-- Немає вільних перевірених ділянок --</option>
                            }
                            @foreach (var p in Model.AvailablePlots)
                            {
                                <option value="@p.Id" selected="@(Model.PreselectedPlotId == p.Id)">@p.CadastralNumber (@p.AreaHectares га, @p.Title — $@p.PriceUsd.ToString("N0"))</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="la-label">Покупець</label>
                        <select name="buyerId" class="la-input" required>
                            @if (!Model.Clients.Any())
                            {
                                <option value="0">-- Немає зареєстрованих клієнтів --</option>
                            }
                            @foreach (var c in Model.Clients)
                            {
                                <option value="@c.Id" selected="@(Model.PreselectedBuyerId == c.Id)">@c.FullName (@c.Phone)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="la-label">Узгоджена сума угоди (USD)</label>
                        <input name="finalPriceUsd" type="number" value="@Model.PreselectedPrice" class="la-input" placeholder="0" required />
                    </div>
                </div>
                <div class="la-grid-3">
                    <div>
                        <label class="la-label">Номер проєкту договору</label>
                        <input name="draftContractNumber" class="la-input" placeholder="Напр. ДГ-2026-108" required />
                    </div>
                    <div>
                        <label class="la-label">Нотаріальна контора</label>
                        <input name="notaryOffice" class="la-input" placeholder="ПІБ нотаріуса / адреса контори" required />
                    </div>
                    <div>
                        <label class="la-label">Дата і час візиту до нотаріуса</label>
                        <input name="notaryDate" type="datetime-local" class="la-input" required />
                    </div>
                </div>

                <div class="la-subcard la-grid-2">
                    <div>
                        <label class="la-label">РНОКПП (ІПН) Покупця для нотаріального договору</label>
                        <input name="buyerTaxId" class="la-input mb-0" placeholder="10 цифр (якщо ще не внесено в профіль)" />
                    </div>
                    <div>
                        <label class="la-label">Рахунок IBAN Продавця для переказу коштів</label>
                        <input name="sellerBankIban" class="la-input mb-0 text-uppercase" placeholder="UAXXXXXXXXXXXXXXXXXXXXXXXXXXX" maxlength="29" minlength="29" pattern="^UA[0-9]{27}$" title="Формат IBAN: UA та 27 цифр" />
                    </div>
                </div>
                <button type="submit" class="la-btn la-btn-amber">1. Сформувати проєкт угоди з рахунками та передати юристу</button>
            </form>
        </div>

        @foreach (var d in Model.Deals)
        {
            <div class="la-card">
                <div class="la-row-between">
                    <h5 class="mb-0">Картка угоди №@d.DraftContractNumber</h5>
                    <span class="la-badge @d.StatusBadgeClass">@d.StatusDisplayName</span>
                </div>

                <p class="la-text-sm my-2">
                    <strong>Ділянка:</strong> @d.LandPlot?.CadastralNumber (@d.LandPlot?.AreaHectares га, @d.LandPlot?.Title)<br />
                    <strong>Продавець:</strong> @d.LandPlot?.Seller?.FullName • <strong>Покупець:</strong> @d.Buyer?.FullName<br />
                    <strong>Ціна угоди:</strong> $@d.FinalPriceUsd.ToString("N0") • <strong>Комісія агентства (3%):</strong> $@d.AgencyCommissionUsd.ToString("N0") •
                    <strong>Оплата депозиту:</strong> @(d.IsAgencyFeePaid ? "Зараховано ✓" : (d.HasPendingPayments ? "Надіслано квитанцію (потребує перевірки) ⏳" : "Очікує оплати за IBAN"))
                </p>
                @if (!string.IsNullOrEmpty(d.LawyerApprovalNotes))
                {
                    <p class="la-text-xs fw-bold text-primary mb-2">Правова віза юриста: @d.LawyerApprovalNotes</p>
                }

                <div class="la-subcard">
                    <strong class="la-text-sm d-block mb-2">Графік рахунків-фактур та банківські платежі:</strong>
                    @if (!d.Payments.Any())
                    {
                        <span class="la-text-xs">Рахунки ще не згенеровано.</span>
                    }
                    else
                    {
                        @foreach (var p in d.Payments)
                        {
                            <div class="la-subcard bg-white la-row-between py-2 px-3 mb-2">
                                <div class="la-text-xs">
                                    <strong>Рахунок @p.InvoiceNumber:</strong> @p.PaymentType — <strong>$@p.AmountUsd.ToString("N0")</strong><br />
                                    <span class="text-muted">Отримувач IBAN: @p.RecipientIban</span>
                                    @if (!string.IsNullOrWhiteSpace(p.PaymentReference))
                                    {
                                        <span class="fw-bold text-primary ms-2">(Квитанція клієнта: @p.PaymentReference)</span>
                                    }
                                </div>
                                <div class="la-action-row">
                                    <span class="la-badge @p.StatusBadgeClass">@p.StatusDisplayName</span>
                                    @if (p.Status == LandAgencyMvc.Models.PaymentStatus.PendingVerification && d.IsActive)
                                    {
                                        <form asp-controller="Realtor" asp-action="VerifyClientPayment" method="post" class="la-inline-form">
                                            <input type="hidden" name="paymentId" value="@p.Id" />
                                            <input name="verificationNotes" class="la-input-inline" placeholder="№ банківської виписки" />
                                            <button type="submit" class="la-btn la-btn-green la-btn-xs">✓ Підтвердити зарахування</button>
                                        </form>
                                        <form asp-controller="Realtor" asp-action="RejectClientPayment" method="post" class="la-inline-form">
                                            <input type="hidden" name="paymentId" value="@p.Id" />
                                            <input type="hidden" name="rejectionNotes" value="Не знайдено у банківській виписці за вказаним референсом" />
                                            <button type="submit" class="la-btn la-btn-red la-btn-xs">✕ Відхилити</button>
                                        </form>
                                    }
                                    else if (p.Status == LandAgencyMvc.Models.PaymentStatus.Confirmed)
                                    {
                                        <span class="la-text-xs fw-bold text-success">Підтверджено випискою ✓</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (d.IsActive)
                {
                    <div class="mt-2">
                        <strong class="la-text-xs d-block mb-2">Управління нотаріальними етапами:</strong>
                        <div class="la-action-row">
                            @if (d.CanSendToLawyer)
                            {
                                <form asp-controller="Realtor" asp-action="SendDealToLawyer" method="post">
                                    <input type="hidden" name="dealId" value="@d.Id" />
                                    <button type="submit" class="la-btn la-btn-indigo la-btn-sm">1. Направити юристу на візу</button>
                                </form>
                            }

                            @if (d.CanSignAtNotary)
                            {
                                <form asp-controller="Realtor" asp-action="SignDealAtNotary" method="post" class="la-inline-form">
                                    <input type="hidden" name="dealId" value="@d.Id" />
                                    <input name="notarialRegistryNumber" value="@d.NotarialRegistryNumber" class="la-input-inline" placeholder="Реєстровий № нотаріуса" />
                                    <button type="submit" class="la-btn la-btn-blue la-btn-sm" title="@(!d.IsAgencyFeePaid ? "Потрібно підтвердити зарахування коштів за квитанцією" : "")">2. Підтвердити підпис у нотаріуса</button>
                                </form>
                            }

                            @if (d.CanCompleteAtNotary)
                            {
                                <form asp-controller="Realtor" asp-action="CompleteNotaryDeal" method="post">
                                    <input type="hidden" name="dealId" value="@d.Id" />
                                    <input type="hidden" name="notarialRegistryNumber" value="@d.NotarialRegistryNumber" />
                                    <button type="submit" class="la-btn la-btn-green la-btn-sm" title="@(!d.IsFullyPaid ? "Потрібно підтвердити всі банківські розрахунки за угодою" : "")">3. Зареєструвати право в ДРРП</button>
                                </form>
                            }

                            @if (d.CanCancel)
                            {
                                <form asp-controller="Realtor" asp-action="CancelDeal" method="post">
                                    <input type="hidden" name="dealId" value="@d.Id" />
                                    <input type="hidden" name="reason" value="Скасовано за погодженням сторін до моменту реєстрації в ДРРП" />
                                    <button type="submit" class="la-btn la-btn-red la-btn-sm">✕ Скасувати угоду</button>
                                </form>
                            }
                        </div>
                    </div>
                }

                <div class="la-action-row mt-3">
                    <a asp-controller="Realtor" asp-action="PrintContract" asp-route-dealId="@d.Id" target="_blank" class="la-btn la-btn-link la-btn-xs">Друкована форма договору (PDF)</a>
                    <a asp-controller="Client" asp-action="DownloadReceipt" asp-route-dealId="@d.Id" target="_blank" class="la-btn la-btn-white la-btn-xs">Рахунок-фактура та квитанція</a>
                </div>
            </div>
        }

        <div class="la-card">
            <h5>Реєстр угод агентства</h5>
            <table class="la-table">
                <thead>
                    <tr>
                        <th>№ ДОГОВОРУ</th>
                        <th>КАДАСТРОВИЙ №</th>
                        <th>СУМА / КОМІСІЯ</th>
                        <th>СТАТУС УГОДИ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Deals)
                    {
                        <tr>
                            <td><strong>@d.DraftContractNumber</strong></td>
                            <td>@d.LandPlot?.CadastralNumber</td>
                            <td><strong>$@d.FinalPriceUsd.ToString("N0")</strong> (комісія $@d.AgencyCommissionUsd.ToString("N0"))</td>
                            <td><span class="la-badge @d.StatusBadgeClass">@d.StatusDisplayName</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

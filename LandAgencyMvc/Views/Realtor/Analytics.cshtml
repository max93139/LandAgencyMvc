@model LandAgencyMvc.Models.PeriodTurnoverViewModel
@{
    ViewData["Title"] = "Фінансова аналітика та оборот — LandAgency UA";
    ViewData["ActiveNav"] = "Analytics";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-card">
            <div class="la-row-between mb-3">
                <div>
                    <h3 class="mb-1">Фінансова аналітика та результативність агентства</h3>
                    <p class="la-meta mb-0">
                        Обраний період звітності: <strong>@Model.Period.Label</strong> (з @Model.Period.From.ToString("dd.MM.yyyy") по @Model.Period.To.AddDays(-1).ToString("dd.MM.yyyy"))
                    </p>
                </div>
                <span class="la-badge la-badge-indigo">Звітний інтервал: @Model.Period.Label</span>
            </div>

            <form method="get" asp-controller="Realtor" asp-action="Analytics">
                <div class="la-grid-4 mb-3">
                    <div>
                        <label class="la-label">Тип звітного періоду</label>
                        <select class="la-input mb-0" name="kind">
                            <option value="Month" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.Month)">Поточний / обраний місяць</option>
                            <option value="HalfYear" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.HalfYear)">Півріччя</option>
                            <option value="Day" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.Day)">Один звітний день</option>
                            <option value="Custom" selected="@(Model.Kind == LandAgencyMvc.Services.PeriodKind.Custom)">Довільний період «з … по …»</option>
                        </select>
                    </div>

                    <div>
                        <label class="la-label">Опорна дата періоду</label>
                        <input type="date" class="la-input mb-0" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="la-label">Довільний період: з дати</label>
                        <input type="date" class="la-input mb-0" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="la-label">Довільний період: по дату</label>
                        <input type="date" class="la-input mb-0" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="la-row-between">
                    <div class="la-action-row">
                        <label class="la-label me-2 mb-0">Сортування підсумків:</label>
                        <select name="sort" class="la-input mb-0">
                            <option value="Turnover" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Turnover)">За фінансовим оборотом ($)</option>
                            <option value="Deals" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Deals)">За кількістю закритих угод</option>
                            <option value="Area" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Area)">За загальною площею (га)</option>
                            <option value="Name" selected="@(Model.Sort == LandAgencyMvc.Services.TurnoverSort.Name)">За найменуванням категорії</option>
                        </select>
                        <select name="desc" class="la-input mb-0">
                            <option value="true" selected="@Model.Descending">За спаданням (↓)</option>
                            <option value="false" selected="@(!Model.Descending)">За зростанням (↑)</option>
                        </select>
                    </div>
                    <button type="submit" class="la-btn la-btn-dark">Сформувати фінансовий звіт</button>
                </div>
            </form>
        </div>

        <div class="la-grid-4 mb-3">
            <div class="la-card">
                <span class="la-badge la-badge-green mb-2">Оборот угод</span>
                <div class="la-price-lg">$@Model.TotalTurnoverUsd.ToString("N0")</div>
                <span class="la-meta">Сумарна сума продажів у USD</span>
            </div>
            <div class="la-card">
                <span class="la-badge la-badge-amber mb-2">Дохід агентства</span>
                <div class="la-price-lg">$@Model.TotalCommissionUsd.ToString("N2")</div>
                <span class="la-meta">Отримана комісія 3% за договорами</span>
            </div>
            <div class="la-card">
                <span class="la-badge la-badge-indigo mb-2">Обсяг продажів</span>
                <div class="la-price-lg">@Model.TotalDeals угод</div>
                <span class="la-meta">@Model.TotalAreaHa.ToString("F2") га відчуженої землі</span>
            </div>
            <div class="la-card">
                <span class="la-badge la-badge-green mb-2">Середній чек</span>
                <div class="la-price-lg">$@Model.AvgDealPriceUsd.ToString("N0")</div>
                <span class="la-meta">Середня вартість однієї ділянки</span>
            </div>
        </div>

        <div class="la-card mb-3">
            <div class="la-row-between mb-2">
                <h4 class="mb-0">Оборот агентства за категоріями земель</h4>
                <span class="la-badge la-badge-green">Категорій у звіті: @Model.ByPurpose.Rows.Count</span>
            </div>
            <p class="la-meta mb-3">Узагальнення нотаріально посвідчених договорів купівлі-продажу у розрізі цільового призначення</p>

            @if (!Model.ByPurpose.Rows.Any())
            {
                <p class="la-meta mb-0">За обраний період закритих угод у базі даних не зафіксовано. Змініть часовий проміжок або оберіть ширший інтервал.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>Цільове призначення ділянки</th>
                            <th class="text-center">К-ть угод</th>
                            <th class="text-end">Площа (га)</th>
                            <th class="text-end">Сумарний оборот ($)</th>
                            <th class="text-end">Комісія 3% ($)</th>
                            <th class="text-end">Сер. ціна ($)</th>
                            <th class="text-end">Мін. ціна ($)</th>
                            <th class="text-end">Макс. ціна ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ByPurpose.Rows)
                        {
                            <tr>
                                <td><strong>@r.Purpose</strong></td>
                                <td class="text-center"><span class="la-badge la-badge-indigo">@r.DealsCount</span></td>
                                <td class="text-end">@r.TotalAreaHectares.ToString("F2")</td>
                                <td class="text-end"><strong>$@r.TotalTurnoverUsd.ToString("N2")</strong></td>
                                <td class="text-end text-success">+$@r.TotalCommissionUsd.ToString("N2")</td>
                                <td class="text-end">$@r.AveragePriceUsd.ToString("N2")</td>
                                <td class="text-end">$@r.MinPriceUsd.ToString("N0")</td>
                                <td class="text-end">$@r.MaxPriceUsd.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Всього за звітний період:</th>
                            <th class="text-center">@Model.TotalDeals</th>
                            <th class="text-end">@Model.TotalAreaHa.ToString("F2") га</th>
                            <th class="text-end"><strong>$@Model.TotalTurnoverUsd.ToString("N2")</strong></th>
                            <th class="text-end text-success">+$@Model.TotalCommissionUsd.ToString("N2")</th>
                            <th class="text-end">$@Model.AvgDealPriceUsd.ToString("N2")</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>

        <div class="la-card">
            <div class="la-row-between mb-2">
                <h4 class="mb-0">Результативність персоналу агентства</h4>
                <span class="la-badge la-badge-indigo">Співробітників задіяно: @Model.ByAgent.Rows.Count</span>
            </div>
            <p class="la-meta mb-3">Оцінка персонального внеску спеціалістів у супровід та юридичну експертизу угод</p>

            @if (!Model.ByAgent.Rows.Any())
            {
                <p class="la-meta mb-0">За обраний період немає активності персоналу за укладеними договорами.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>Спеціаліст</th>
                            <th>Посада / Роль в агентстві</th>
                            <th>Контактний телефон</th>
                            <th class="text-center">К-ть угод</th>
                            <th class="text-end">Площа (га)</th>
                            <th class="text-end">Загальний оборот ($)</th>
                            <th class="text-end">Зароблена комісія ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.ByAgent.Rows)
                        {
                            <tr>
                                <td><strong>@a.AgentName</strong></td>
                                <td>
                                    @if (a.RoleTitle.Contains("Рієлтор"))
                                    {
                                        <span class="la-badge la-badge-amber">@a.RoleTitle</span>
                                    }
                                    else
                                    {
                                        <span class="la-badge la-badge-indigo">@a.RoleTitle</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(a.Phone) ? "—" : a.Phone)</td>
                                <td class="text-center"><span class="la-badge la-badge-green">@a.DealsCount</span></td>
                                <td class="text-end">@a.TotalAreaHectares.ToString("F2")</td>
                                <td class="text-end"><strong>$@a.TotalTurnoverUsd.ToString("N2")</strong></td>
                                <td class="text-end text-success">+$@a.TotalCommissionUsd.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
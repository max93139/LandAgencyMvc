@model IEnumerable<LandAgencyMvc.Models.ViewingRequest>
@{
    ViewData["Title"] = "Черга заявок на виїзний огляд — Панель Рієлтора";
    ViewData["ActiveNav"] = "Viewings";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <h4 class="mb-3">Черга заявок на виїзний огляд земельних ділянок</h4>

        @if (!Model.Any())
        {
            <div class="la-card">
                <p class="la-meta mb-0">Заявок на виїзний огляд ділянок наразі немає.</p>
            </div>
        }
        else
        {
            @foreach (var v in Model)
            {
                <div class="la-card">
                    <div class="la-row-between">
                        <h5 class="mb-0">Заявка на огляд №@v.Id — Ділянка @v.LandPlot?.CadastralNumber (@v.LandPlot?.Title)</h5>
                        <span class="la-badge @v.StatusBadgeClass">@v.StatusDisplayName</span>
                    </div>

                    <p class="la-text-sm my-2">
                        <strong>Покупець:</strong> @v.Buyer?.FullName (@v.Buyer?.Phone) •
                        <strong>Продавець:</strong> @v.LandPlot?.Seller?.FullName •
                        <strong>Ціна ділянки:</strong> $@v.LandPlot?.PriceUsd.ToString("N0")
                    </p>
                    <p class="la-text-sm mb-2">
                        <strong>Дата та час виїзду:</strong> <code class="la-code">@v.PreferredDate.ToString("dd.MM.yyyy") @v.TimeSlot</code>
                        @if (!string.IsNullOrEmpty(v.Comment))
                        {
                            <span> • Коментар покупця: «@v.Comment»</span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(v.ResultNotes))
                    {
                        <p class="la-text-xs fw-bold text-success mb-2">Результат огляду: @v.ResultNotes</p>
                    }

                    <div class="la-action-row mt-2">
                        @if (v.Status == LandAgencyMvc.Models.ViewingStatus.NewRequest)
                        {
                            <form asp-controller="Realtor" asp-action="UpdateViewingStatus" method="post">
                                <input type="hidden" name="viewingId" value="@v.Id" />
                                <input type="hidden" name="status" value="Scheduled" />
                                <button type="submit" class="la-btn la-btn-green la-btn-sm">✓ Підтвердити огляд</button>
                            </form>
                            <form asp-controller="Realtor" asp-action="UpdateViewingStatus" method="post">
                                <input type="hidden" name="viewingId" value="@v.Id" />
                                <input type="hidden" name="status" value="Completed" />
                                <button type="submit" class="la-btn la-btn-amber la-btn-sm">Огляд проведено (Клієнт купує)</button>
                            </form>
                            <form asp-controller="Realtor" asp-action="UpdateViewingStatus" method="post">
                                <input type="hidden" name="viewingId" value="@v.Id" />
                                <input type="hidden" name="status" value="Cancelled" />
                                <button type="submit" class="la-btn la-btn-red la-btn-sm">✕ Скасувати</button>
                            </form>
                        }
                        else if (v.Status == LandAgencyMvc.Models.ViewingStatus.Scheduled)
                        {
                            <form asp-controller="Realtor" asp-action="UpdateViewingStatus" method="post">
                                <input type="hidden" name="viewingId" value="@v.Id" />
                                <input type="hidden" name="status" value="Completed" />
                                <button type="submit" class="la-btn la-btn-green la-btn-sm">✓ Провести огляд (Ділянка підходить)</button>
                            </form>
                            <form asp-controller="Realtor" asp-action="UpdateViewingStatus" method="post" class="la-inline-form">
                                <input type="hidden" name="viewingId" value="@v.Id" />
                                <input type="hidden" name="status" value="PlotRejectedByBuyer" />
                                <input name="resultNotes" class="la-input-inline" placeholder="Зауваження покупця" />
                                <button type="submit" class="la-btn la-btn-warning la-btn-sm">Не підійшла (Зафіксувати зауваження)</button>
                            </form>
                            <form asp-controller="Realtor" asp-action="UpdateViewingStatus" method="post">
                                <input type="hidden" name="viewingId" value="@v.Id" />
                                <input type="hidden" name="status" value="Cancelled" />
                                <button type="submit" class="la-btn la-btn-red la-btn-sm">✕ Скасувати</button>
                            </form>
                        }
                        else if (v.CanCreateDeal)
                        {
                            <a class="la-btn la-btn-blue la-btn-sm" asp-controller="Realtor" asp-action="Deals" asp-route-plotId="@v.LandPlotId" asp-route-buyerId="@v.BuyerId">Створити проєкт угоди продажу →</a>
                        }
                        else if (v.Status == LandAgencyMvc.Models.ViewingStatus.Completed && v.LandPlot?.Status == LandAgencyMvc.Models.PlotStatus.Sold)
                        {
                            <span class="la-badge la-badge-green">Ділянку продано ✓</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

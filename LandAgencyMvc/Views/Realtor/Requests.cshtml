@model LandAgencyMvc.Models.RealtorRequestsViewModel
@{
    ViewData["Title"] = "Вхідні запити та Опис ділянки — Панель Рієлтора";
    ViewData["ActiveNav"] = "Requests";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h5 style="margin:0;">Клієнтські запити на підбір (Автоматичний двигун AutoMatching)</h5>
                <span class="la-badge la-badge-green">AI/AutoMatching Активний ✓</span>
            </div>
            @if (!Model.SelectionRequests.Any())
            {
                <p class="text-muted" style="margin:0; font-size:13px;">Нових запитів на індивідуальний підбір ділянки наразі немає.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>КЛІЄНТ / ТЕЛЕФОН</th>
                            <th>РАЙОН / МІН. ПЛОЩА</th>
                            <th>ЦІЛЬОВЕ ПРИЗНАЧЕННЯ</th>
                            <th>БЮДЖЕТ</th>
                            <th>СТАТУС / ДІЯ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.SelectionRequests)
                        {
                            <tr>
                                <td><strong>@r.Buyer?.FullName</strong><br /><small class="text-muted">@r.Buyer?.Phone</small></td>
                                <td>@r.DesiredDistrict (від @r.MinAreaHa га)</td>
                                <td>@r.Purpose</td>
                                <td><strong>до $@r.MaxBudgetUsd.ToString("N0")</strong></td>
                                <td>
                                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                        @if (r.MatchedPlotsCount > 0)
                                        {
                                            <span class="la-badge la-badge-green">Підібрано автоматично ✓ (@r.MatchedPlotsCount)</span>
                                            <a asp-controller="Realtor" asp-action="Requests" asp-route-matchedRequestId="@r.Id" style="font-size:12px; color:#b45309; font-weight:700; text-decoration:none;">Показати</a>
                                        }
                                        else
                                        {
                                            <span class="la-badge la-badge-amber">В обробці (0 збігів)</span>
                                        }
                                        <form asp-controller="Realtor" asp-action="MatchPlotsForRequest" method="post" style="display:inline-flex; gap:4px;">
                                            <input type="hidden" name="requestId" value="@r.Id" />
                                            <button type="submit" class="la-btn" style="padding:4px 8px; font-size:11px; background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Перерахувати збіги</button>
                                        </form>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(r.RealtorNotes))
                                    {
                                        <div style="font-size:11px; color:#64748b; margin-top:4px;">@r.RealtorNotes</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.MatchedPlotsPreview.Any())
            {
                <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:12px; margin-top:14px;">
                    <strong style="font-size:13px; color:#92400e;">Підібрані земельні ділянки для запиту #@Model.SelectedRequestId:</strong>
                    <ul style="margin:6px 0 0 0; font-size:13px;">
                        @foreach (var mp in Model.MatchedPlotsPreview)
                        {
                            <li style="margin-bottom:4px;">
                                <strong>@mp.CadastralNumber</strong> — @mp.Title (@mp.AreaHectares га, @mp.Location) — <strong>$@mp.PriceUsd.ToString("N0")</strong>
                                <a href="https://kadastr.live/parcel/@mp.CadastralNumber" target="_blank" style="margin-left:8px; color:#2563eb; text-decoration:none;">(Карта ↗)</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="la-card">
            <h5>Редагування комерційного опису ділянки для каталогу</h5>
            @if (!Model.AllPlots.Any())
            {
                <p class="text-muted" style="margin:0; font-size:13px;">У базі ще немає зареєстрованих ділянок.</p>
            }
            else
            {
                <form asp-controller="Realtor" asp-action="UpdatePlotDescription" method="post">
                    <label class="la-label">Обрана ділянка</label>
                    <select name="plotId" class="la-input">
                        @foreach (var p in Model.AllPlots)
                        {
                            <option value="@p.Id">@p.CadastralNumber (@p.AreaHectares га, @p.Title — $@p.PriceUsd.ToString("N0"))</option>
                        }
                    </select>
                    <label class="la-label">Комерційний опис ділянки для каталогу</label>
                    <textarea name="description" rows="3" class="la-input" placeholder="Введіть комерційний опис ділянки, під'їзних шляхів та інженерних мереж" required></textarea>
                    <button type="submit" class="la-btn la-btn-dark">Зберегти опис ділянки</button>
                </form>
            }
        </div>
    </div>
</div>

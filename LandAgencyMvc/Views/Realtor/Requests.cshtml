@model LandAgencyMvc.Models.RealtorRequestsViewModel
@{
    ViewData["Title"] = "Вхідні запити та Опис ділянки — Панель Рієлтора";
    int userId = Model.CurrentUser?.Id ?? 0;
}

<div class="la-window">
    <div class="la-topbar la-topbar-realtor">
        <div class="la-nav-links">
            <span class="la-badge la-badge-amber" style="margin-right:8px;">РІЄЛТОР</span>
            <a class="active" asp-controller="Realtor" asp-action="Requests" asp-route-userId="@userId">Запити на підбір</a>
            <a asp-controller="Realtor" asp-action="Viewings" asp-route-userId="@userId">Черга оглядів</a>
            <a asp-controller="Realtor" asp-action="Deals" asp-route-userId="@userId">Угоди та нотаріат</a>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <span style="font-size:13px;">@Model.CurrentUser?.FullName (@Model.CurrentUser?.LicenseNumber)</span>
            <a class="la-btn la-btn-outline" asp-controller="Account" asp-action="Logout">Вийти</a>
        </div>
    </div>

    <div class="la-body">
        @if (TempData["RealtorMessage"] != null)
        {
            <div class="la-alert la-alert-success">
                @TempData["RealtorMessage"]
            </div>
        }
        @if (TempData["RealtorError"] != null)
        {
            <div class="la-alert la-alert-error">
                @TempData["RealtorError"]
            </div>
        }

        <div class="la-card">
            <h5>Вхідні запити від клієнтів на індивідуальний підбір</h5>
            @if (!Model.SelectionRequests.Any())
            {
                <p class="text-muted" style="margin:0; font-size:13px;">Нових запитів на індивідуальний підбір ділянки наразі немає.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>КЛІЄНТ / ТЕЛЕФОН</th>
                            <th>РАЙОН / МІН. ПЛОЩА</th>
                            <th>ЦІЛЬОВЕ ПРИЗНАЧЕННЯ</th>
                            <th>БЮДЖЕТ</th>
                            <th>СТАТУС / ДІЯ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.SelectionRequests)
                        {
                            <tr>
                                <td><strong>@r.Buyer?.FullName</strong><br /><small class="text-muted">@r.Buyer?.Phone</small></td>
                                <td>@r.DesiredDistrict (від @r.MinAreaHa га)</td>
                                <td>@r.Purpose</td>
                                <td><strong>до $@r.MaxBudgetUsd.ToString("N0")</strong></td>
                                <td>
                                    @if (r.IsProcessedByRealtor)
                                    {
                                        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                            <span class="la-badge la-badge-green">Підбір надіслано ✓ (@r.MatchedPlotsCount)</span>
                                            <a asp-controller="Realtor" asp-action="Requests" asp-route-userId="@userId" asp-route-matchedRequestId="@r.Id" style="font-size:12px; color:#b45309; font-weight:700; text-decoration:none;">Показати</a>
                                            <form asp-controller="Realtor" asp-action="MatchPlotsForRequest" method="post" style="display:inline;">
                                                <input type="hidden" name="userId" value="@userId" />
                                                <input type="hidden" name="requestId" value="@r.Id" />
                                                <input type="hidden" name="realtorNotes" value="@r.RealtorNotes" />
                                                <button type="submit" class="la-btn" style="padding:4px 8px; font-size:11px; background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Оновити підбір</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-controller="Realtor" asp-action="MatchPlotsForRequest" method="post" style="display:flex; gap:6px; align-items:center;">
                                            <input type="hidden" name="userId" value="@userId" />
                                            <input type="hidden" name="requestId" value="@r.Id" />
                                            <input name="realtorNotes" class="la-input" style="margin:0; padding:6px 10px; font-size:12px; width:190px;" placeholder="Коментар рієлтора" />
                                            <button type="submit" class="la-btn la-btn-amber" style="padding:6px 12px; font-size:12px;">Підібрати ділянки</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.MatchedPlotsPreview.Any())
            {
                <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:12px; margin-top:14px;">
                    <strong style="font-size:13px;">Підібрані земельні ділянки для запиту #@Model.SelectedRequestId:</strong>
                    <ul style="margin:6px 0 0 0; font-size:13px;">
                        @foreach (var mp in Model.MatchedPlotsPreview)
                        {
                            <li><strong>@mp.CadastralNumber</strong> — @mp.Title (@mp.AreaHectares га, @mp.Location) — $@mp.PriceUsd.ToString("N0")</li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="la-card">
            <h5>Редагування комерційного опису ділянки для каталогу</h5>
            @if (!Model.AllPlots.Any())
            {
                <p class="text-muted" style="margin:0; font-size:13px;">У базі ще немає зареєстрованих ділянок.</p>
            }
            else
            {
                <form asp-controller="Realtor" asp-action="UpdatePlotDescription" method="post">
                    <input type="hidden" name="userId" value="@userId" />
                    <label class="la-label">Обрана ділянка</label>
                    <select name="plotId" class="la-input">
                        @foreach (var p in Model.AllPlots)
                        {
                            <option value="@p.Id">@p.CadastralNumber (@p.AreaHectares га, @p.Title — $@p.PriceUsd.ToString("N0"))</option>
                        }
                    </select>
                    <label class="la-label">Комерційний опис ділянки для каталогу</label>
                    <textarea name="description" rows="3" class="la-input" placeholder="Введіть комерційний опис ділянки, під'їзних шляхів та інженерних мереж" required></textarea>
                    <button type="submit" class="la-btn la-btn-dark">Зберегти опис ділянки</button>
                </form>
            }
        </div>
    </div>
</div>

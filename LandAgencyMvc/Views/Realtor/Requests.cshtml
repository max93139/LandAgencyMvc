@model LandAgencyMvc.Models.RealtorRequestsViewModel
@{
    ViewData["Title"] = "Вхідні запити та Опис ділянки — Панель Рієлтора";
    ViewData["ActiveNav"] = "Requests";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <partial name="_AlertMessages" />

        <div class="la-card">
            <div class="la-row-between mb-2">
                <h5 class="mb-0">Клієнтські запити на підбір ділянок</h5>
                <span class="la-badge la-badge-indigo">Запитів у черзі: @Model.SelectionRequests.Count</span>
            </div>
            @if (!Model.SelectionRequests.Any())
            {
                <p class="la-meta mb-0">Нових запитів на індивідуальний підбір ділянки наразі немає.</p>
            }
            else
            {
                <table class="la-table">
                    <thead>
                        <tr>
                            <th>КЛІЄНТ / ТЕЛЕФОН</th>
                            <th>РАЙОН / МІН. ПЛОЩА</th>
                            <th>ЦІЛЬОВЕ ПРИЗНАЧЕННЯ</th>
                            <th>БЮДЖЕТ</th>
                            <th>ПІДІБРАНІ ВАРІАНТИ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.SelectionRequests)
                        {
                            <tr>
                                <td><strong>@r.Buyer?.FullName</strong><br /><small class="text-muted">@r.Buyer?.Phone</small></td>
                                <td>@r.DesiredDistrict (від @r.MinAreaHa га)</td>
                                <td>@r.Purpose</td>
                                <td><strong>до $@r.MaxBudgetUsd.ToString("N0")</strong></td>
                                <td>
                                    <div class="la-action-row">
                                        @if (r.EffectiveMatchedCount > 0)
                                        {
                                            <span class="la-badge la-badge-green">Знайдено варіантів: @r.EffectiveMatchedCount</span>
                                            <a asp-controller="Realtor" asp-action="Requests" asp-route-matchedRequestId="@r.Id" class="la-btn la-btn-outline-dark la-btn-xs">Переглянути</a>
                                        }
                                        else
                                        {
                                            <span class="la-badge la-badge-amber">Немає збігів (0)</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(r.RealtorNotes))
                                    {
                                        <div class="la-text-xs mt-1">@r.RealtorNotes</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.MatchedPlotsPreview.Any())
            {
                <div class="la-subcard-amber mt-3 mb-0">
                    <strong class="la-text-sm">Підібрані земельні ділянки для запиту #@Model.SelectedRequestId:</strong>
                    <ul class="mt-2 mb-0 la-text-sm">
                        @foreach (var mp in Model.MatchedPlotsPreview)
                        {
                            <li class="mb-1">
                                <strong>@mp.CadastralNumber</strong> — @mp.Title (@mp.AreaHectares га, @mp.Location) — <strong>$@mp.PriceUsd.ToString("N0")</strong>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="la-card">
            <h5>Оновлення даних земельної ділянки</h5>
            @if (!Model.AllPlots.Any())
            {
                <p class="la-meta mb-0">У базі ще немає зареєстрованих ділянок.</p>
            }
            else
            {
                <form asp-controller="Realtor" asp-action="UpdatePlot" method="post">
                    @Html.AntiForgeryToken()
                    <div class="la-grid-3">
                        <div>
                            <label class="la-label">Обрана ділянка</label>
                            <select name="plotId" class="la-input">
                                @foreach (var p in Model.AllPlots.Where(p => p.Status != LandAgencyMvc.Models.PlotStatus.Sold))
                                {
                                    <option value="@p.Id">@p.CadastralNumber (@p.Title — $@p.PriceUsd.ToString("N0"))</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="la-label">Нова ціна продажу ($) (за потреби)</label>
                            <input name="priceUsd" type="number" step="100" min="1" class="la-input" placeholder="Залиште порожнім, щоб не змінювати" />
                        </div>
                        <div>
                            <label class="la-label">Нова назва оголошення (за потреби)</label>
                            <input name="title" class="la-input" placeholder="Залиште порожнім, щоб не змінювати" />
                        </div>
                    </div>
                    <label class="la-label">Комерційний опис ділянки для каталогу (за потреби)</label>
                    <textarea name="description" rows="2" class="la-input" placeholder="Оновлений опис ділянки, під'їзних шляхів та комунікацій"></textarea>
                    <button type="submit" class="la-btn la-btn-dark">Зберегти зміни ділянки</button>
                </form>
            }
        </div>
    </div>
</div>

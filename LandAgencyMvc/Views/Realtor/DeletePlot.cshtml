@model LandAgencyMvc.Models.DeletePlotConfirmationViewModel
@{
    ViewData["Title"] = $"Вилучення ділянки {Model.Plot.CadastralNumber}";
    ViewData["ActiveNav"] = "Plots";
}

<div class="la-window">
    <partial name="_RealtorNavbar" />

    <div class="la-body">
        <div class="container-fluid px-0">
            <div class="la-page-header">
                <div>
                    <div class="mb-2">
                        <a asp-action="Plots" class="text-decoration-none">&larr; Повернутися до реєстру ділянок</a>
                    </div>
                    <h1 class="la-page-title text-danger">Вилучення земельної ділянки</h1>
                    <p class="la-meta mb-0">Фото й відео вилучаються разом із ділянкою, а документи, висновок, огляди й угоди блокують вилучення</p>
                </div>
            </div>

            @await Html.PartialAsync("_AlertMessages")

            <div class="la-card mb-4">
                <h3 class="la-card-title mb-3">Відомості про об'єкт</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="la-meta">Кадастровий номер</div>
                        <div class="fw-bold fs-5">@Model.Plot.CadastralNumber</div>
                    </div>
                    <div class="col-md-4">
                        <div class="la-meta">Назва ділянки</div>
                        <div class="fw-semibold">@Model.Plot.Title</div>
                    </div>
                    <div class="col-md-4">
                        <div class="la-meta">Власник (продавець)</div>
                        <div>@(Model.Plot.Seller?.FullName ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="la-meta">Площа / Ціна</div>
                        <div>@Model.Plot.AreaHectares га / $@Model.Plot.PriceUsd.ToString("N0")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="la-meta">Місцезнаходження</div>
                        <div>@Model.Plot.Location</div>
                    </div>
                    <div class="col-md-4">
                        <div class="la-meta">Поточний статус</div>
                        <span class="la-badge @Model.Plot.StatusBadgeClass">@Model.Plot.StatusDisplayName</span>
                    </div>
                </div>
            </div>

            <div class="la-card mb-4">
                <h3 class="la-card-title mb-3">Що станеться з пов'язаними записами</h3>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Пов'язані записи</th>
                                <th>Кількість</th>
                                <th>Правило</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>PlotMedia</strong> (фото й відео ділянки)</td>
                                <td>@Model.MediaCount</td>
                                <td>Вилучаються разом із ділянкою (ON DELETE CASCADE): без ділянки вони не мають сенсу і не є юридичними записами.</td>
                            </tr>
                            <tr class="@(Model.DocumentsCount > 0 ? "table-warning" : "")">
                                <td><strong>PlotDocuments</strong> (правовстановлюючі документи)</td>
                                <td>@Model.DocumentsCount</td>
                                <td>Блокують вилучення (ON DELETE RESTRICT): документи потрібні для звітності. Неверифіковані документи можна вилучити окремо у формі редагування.</td>
                            </tr>
                            <tr class="@(Model.HasLegalConclusion ? "table-warning" : "")">
                                <td><strong>LegalConclusions</strong> (висновок юриста)</td>
                                <td>@(Model.HasLegalConclusion ? 1 : 0)</td>
                                <td>Блокує вилучення (RESTRICT): висновок зберігається для аудиту земельного банку.</td>
                            </tr>
                            <tr class="@(Model.ViewingsCount > 0 ? "table-warning" : "")">
                                <td><strong>ViewingRequests</strong> (заявки на огляд)</td>
                                <td>@Model.ViewingsCount</td>
                                <td>Блокують вилучення (RESTRICT): огляди — історія роботи з покупцями.</td>
                            </tr>
                            <tr class="@(Model.DealsCount > 0 ? "table-warning" : "")">
                                <td><strong>SaleDeals</strong> (угоди купівлі-продажу)</td>
                                <td>@Model.DealsCount</td>
                                <td>Блокують вилучення (RESTRICT): на угодах тримаються оплати й фінансова звітність.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.CanBeDeleted)
            {
                <div class="la-alert la-alert-danger mb-4">
                    <strong>Цю ділянку вилучити не можна.</strong> Вилучається лише чернетка, яку ще не відправляли юристу і до якої не додано документів. Причини:
                    <ul class="mb-0 mt-2">
                        @foreach (var blocker in Model.Blockers)
                        {
                            <li>@blocker</li>
                        }
                    </ul>
                </div>
                <div class="la-action-row">
                    @if (Model.Plot.IsEditable)
                    {
                        <a asp-action="EditPlot" asp-route-id="@Model.Plot.Id" class="la-btn la-btn-outline-dark">Відкрити форму редагування</a>
                    }
                    <a asp-action="Plots" class="la-btn la-btn-outline">Повернутися до реєстру</a>
                </div>
            }
            else
            {
                <div class="la-card mb-4">
                    <h3 class="la-card-title mb-2">Вилучення ділянки</h3>
                    <p class="la-meta">Ділянка вилучиться разом із фото й відео (@Model.MediaCount). Перед вилученням її копія з причиною, автором і часом записується в <a asp-action="PlotArchive">архів</a>.</p>
                    <form method="post" asp-action="DeletePlotConfirmed" asp-route-id="@Model.Plot.Id">
                        @Html.AntiForgeryToken()
                        <label class="form-label small fw-semibold">Причина вилучення</label>
                        <input type="text" name="reason" class="form-control mb-3" required maxlength="300" />
                        <button type="submit" class="la-btn la-btn-danger" onclick="return confirm('Вилучити ділянку @Model.Plot.CadastralNumber разом із фото й відео?');">Видалити ділянку</button>
                        <a asp-action="Plots" class="la-btn la-btn-outline">Скасувати</a>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

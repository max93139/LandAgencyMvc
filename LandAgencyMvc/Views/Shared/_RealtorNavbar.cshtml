@{
    var activeNav = (ViewData["ActiveNav"] as string) ?? "";
    var currentUser = (Model as LandAgencyMvc.Models.RealtorRequestsViewModel)?.CurrentUser
        ?? (Model as LandAgencyMvc.Models.RealtorDealsViewModel)?.CurrentUser;
    var fullName = currentUser?.FullName ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Рієлтор");
    var rawLicense = !string.IsNullOrEmpty(currentUser?.LicenseNumber)
        ? currentUser.LicenseNumber
        : User.FindFirst("StaffCredential")?.Value;
    var license = !string.IsNullOrEmpty(rawLicense) ? $" ({rawLicense})" : "";
}

<div class="la-topbar la-topbar-realtor">
    <div class="la-nav-links">
        <span class="la-badge la-badge-amber me-2">РІЄЛТОР</span>
        <a class="@(activeNav == "Requests" ? "active" : "")" asp-controller="Realtor" asp-action="Requests">Запити на підбір</a>
        <a class="@(activeNav == "Viewings" ? "active" : "")" asp-controller="Realtor" asp-action="Viewings">Черга оглядів</a>
        <a class="@(activeNav == "Deals" ? "active" : "")" asp-controller="Realtor" asp-action="Deals">Угоди та нотаріат</a>
    </div>
    <div class="la-topbar-user">
        <span>@fullName@license</span>
        <a class="la-btn la-btn-outline" asp-controller="Account" asp-action="Logout">Вийти</a>
    </div>
</div>

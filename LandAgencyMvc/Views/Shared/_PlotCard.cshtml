@model LandAgencyMvc.Models.LandPlot

<div class="la-card">
    <div class="la-row-start">
        <div class="la-action-row">
            <span class="la-badge la-badge-green">✓ Перевірено ДЗК</span>
            @if (Model.LegalConclusion != null && !string.IsNullOrEmpty(Model.LegalConclusion.ConclusionNumber))
            {
                <span class="la-badge la-badge-indigo">Висновок №@Model.LegalConclusion.ConclusionNumber</span>
            }
        </div>
        <strong class="la-price-lg">$@Model.PriceUsd.ToString("N0")</strong>
    </div>
    <h5 class="mt-2 mb-1">@Model.Title (@Model.AreaHectares га / @Model.AreaSotky сот.)</h5>
    <p class="la-meta">Кадастр: <strong>@Model.CadastralNumber</strong></p>
    <p class="la-meta">Призначення: @Model.Purpose</p>
    <p class="mb-2">📍 @Model.Location • Власник: <strong>@Model.Seller?.FullName</strong></p>
    <p class="la-text-sm mb-3">@Model.Description</p>
    <a class="la-btn la-btn-dark la-btn-full" asp-controller="Client" asp-action="Details" asp-route-id="@Model.Id">Детальніше та запис на огляд →</a>
</div>

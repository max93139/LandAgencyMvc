@model LandAgencyMvc.Models.LandPlot

<div class="la-card">
    <div style="display:flex; justify-content:space-between; align-items:start;">
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <span class="la-badge la-badge-green">✓ Перевірено ДЗК</span>
            @if (Model.LegalConclusion != null && !string.IsNullOrEmpty(Model.LegalConclusion.ConclusionNumber))
            {
                <span class="la-badge la-badge-indigo">Висновок №@Model.LegalConclusion.ConclusionNumber</span>
            }
        </div>
        <strong style="font-size:22px; color:#15803d;">$@Model.PriceUsd.ToString("N0")</strong>
    </div>
    <h5 style="margin-top:12px; margin-bottom:6px;">@Model.Title (@Model.AreaHectares га)</h5>
    <p class="text-muted" style="margin-bottom:4px; font-size:13px;">Кадастр: <strong>@Model.CadastralNumber</strong></p>
    <p class="text-muted" style="margin-bottom:4px; font-size:13px;">Призначення: @Model.Purpose</p>
    <p style="margin-bottom:8px; font-size:14px;">📍 @Model.Location • Власник: <strong>@Model.Seller?.FullName</strong></p>
    <p style="font-size:13px; color:#475569; margin-bottom:14px;">@Model.Description</p>
    <a class="la-btn la-btn-dark" style="width:100%; text-align:center;" asp-controller="Client" asp-action="Details" asp-route-id="@Model.Id">Детальніше та запис на огляд →</a>
</div>

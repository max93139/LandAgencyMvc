@model LandAgencyMvc.Models.LandPlot

@if (Model != null && !string.IsNullOrWhiteSpace(Model.CadastralNumber))
{
    <div class="la-action-row">
        <a href="@Model.KadastrLiveUrl" target="_blank" class="la-btn la-btn-kadastr la-btn-sm">🗺️ Публічна кадастрова карта ↗</a>
        <a href="@Model.OpenDataBotUrl" target="_blank" class="la-btn la-btn-opendata la-btn-sm">🔍 OpenDataBot ↗</a>
    </div>
}

@model string

@if (!string.IsNullOrWhiteSpace(Model))
{
    var cleanNumber = Uri.EscapeDataString(Model.Trim());
    var kadastrUrl = $"https://kadastr.live/parcel/{cleanNumber}";
    var openDataUrl = $"https://opendatabot.ua/c/{cleanNumber}";

    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <a href="@kadastrUrl" target="_blank" class="la-btn" style="background:#e0e7ff; color:#3730a3; font-size:12px; padding:6px 12px; text-decoration:none;">🗺️ Публічна карта (kadastr.live) ↗</a>
        <a href="@openDataUrl" target="_blank" class="la-btn" style="background:#e0f2fe; color:#0369a1; font-size:12px; padding:6px 12px; text-decoration:none;">🔍 OpenDataBot ↗</a>
    </div>
}

@{
    var activeNav = (ViewData["ActiveNav"] as string) ?? "";
    var currentUser = (Model as LandAgencyMvc.Models.LawyerQueueViewModel)?.CurrentUser
        ?? (Model as LandAgencyMvc.Models.LawyerConclusionViewModel)?.CurrentUser;
    var fullName = currentUser?.FullName ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Юрист");
    var rawCert = !string.IsNullOrEmpty(currentUser?.CertificateNumber)
        ? currentUser.CertificateNumber
        : User.FindFirst("StaffCredential")?.Value;
    var cert = !string.IsNullOrEmpty(rawCert) ? $" ({rawCert})" : "";
    var plotId = (Model as LandAgencyMvc.Models.LawyerConclusionViewModel)?.Plot?.Id
        ?? (Model as LandAgencyMvc.Models.LandPlot)?.Id;
}

<div class="la-topbar la-topbar-lawyer">
    <div class="la-nav-links">
        <span class="la-badge la-badge-indigo me-2">ЮРИСТ</span>
        <a class="@(activeNav == "Queue" ? "active" : "")" asp-controller="Lawyer" asp-action="Queue">Черга перевірки ДЗК</a>
        @if (plotId.HasValue && plotId.Value > 0)
        {
            <a class="@(activeNav == "Conclusion" ? "active" : "")" asp-controller="Lawyer" asp-action="Conclusion" asp-route-id="@plotId.Value">Юридичний висновок</a>
        }
        else
        {
            <a class="@(activeNav == "Conclusion" ? "active" : "")" asp-controller="Lawyer" asp-action="Conclusion">Юридичний висновок</a>
        }
        <a class="@(activeNav == "Contracts" ? "active" : "")" asp-controller="Lawyer" asp-action="Contracts">Погодження договорів</a>
    </div>
    <div class="la-topbar-user">
        <span>@fullName@cert</span>
        <a class="la-btn la-btn-outline" asp-controller="Account" asp-action="Logout">Вийти</a>
    </div>
</div>

@{
    var activeNav = (ViewData["ActiveNav"] as string) ?? "";
    var displayName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Гість";
}

<div class="la-topbar la-topbar-client">
    <div class="la-nav-links">
        <strong class="la-brand">LandAgency UA</strong>
        <a class="@(activeNav == "QueriesOverview" ? "active" : "")" asp-controller="Queries" asp-action="Index">Огляд (БД & Статистика)</a>
        <a class="@(activeNav == "FilterPlots" ? "active" : "")" asp-controller="Queries" asp-action="FilterPlots">1. Фільтр ділянок</a>
        <a class="@(activeNav == "PeriodTurnover" ? "active" : "")" asp-controller="Queries" asp-action="PeriodTurnover">2–3. Оборот за період</a>
        <a class="@(activeNav == "LandBank" ? "active" : "")" asp-controller="Queries" asp-action="LandBank">4. Земельний банк (4 табл.)</a>
        <a class="@(activeNav == "Users" ? "active" : "")" asp-controller="Queries" asp-action="Users">5–8. Користувачі (CRUD & Restrict)</a>
        <a class="@(activeNav == "LinqShowcase" ? "active" : "")" asp-controller="Queries" asp-action="LinqShowcase">Оператори LINQ (Всі типи)</a>
        <a asp-controller="Client" asp-action="Catalog">Каталог</a>
    </div>
    <div class="la-topbar-user">
        <span class="la-badge la-badge-indigo">ЛР №3 LINQ</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@displayName</span>
            <a class="la-btn la-btn-outline" asp-controller="Account" asp-action="Logout">Вийти</a>
        }
        else
        {
            <a class="la-btn la-btn-outline" asp-controller="Account" asp-action="Login">Увійти</a>
        }
    </div>
</div>
